@model HelpdeskSystem.Models.Domain.Category

@{
    ViewBag.Title = "Thêm mới Danh mục";
    var depts = ViewBag.Departments as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
}

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Thêm Danh mục Mới</h6>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("CategoryCreate", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    @Html.LabelFor(m => m.Name, "Tên danh mục", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", required = "required", placeholder = "Nhập tên danh mục..." })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.DepartmentId, "Phòng ban xử lý", new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(m => m.DepartmentId, depts, "-- Chọn phòng ban --", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.DepartmentId, "", new { @class = "text-danger" })
                </div>

                <div class="mb-4">
                    @Html.LabelFor(m => m.Description, "Mô tả", new { @class = "form-label fw-bold" })
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "3", placeholder = "Nhập mô tả chi tiết..." })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                </div>

                <div class="d-flex justify-content-end">
                    <a href="@Url.Action("Categories", "Admin")" class="btn btn-secondary me-2">Hủy</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu Mới</button>
                </div>
            }
        </div>
    </div>
</div>

@model HelpdeskSystem.Models.Domain.Department

@{
    ViewBag.Title = "Chỉnh sửa Phòng Ban";
}

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Chỉnh sửa Phòng Ban</h6>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("DepartmentEdit", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.DepartmentId)

                <div class="mb-3">
                    @Html.LabelFor(m => m.Name, "Tên phòng ban", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Description, "Mô tả", new { @class = "form-label fw-bold" })
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "3" })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                </div>

                <div class="mb-4">
                    <div class="form-check form-switch mt-2">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "IsActiveCheck" })
                        <label class="form-check-label fw-bold" for="IsActiveCheck">Trạng thái Hoạt động</label>
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <a href="@Url.Action("Departments", "Admin")" class="btn btn-secondary me-2">Hủy</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu Thay Đổi</button>
                </div>
            }
        </div>
    </div>
</div>



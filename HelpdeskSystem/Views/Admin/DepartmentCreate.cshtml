@model HelpdeskSystem.Models.Domain.Department

@{
    ViewBag.Title = "Thêm mới Phòng Ban";
}

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Thêm Phòng Ban Mới</h6>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("DepartmentCreate", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    @Html.LabelFor(m => m.Name, "Tên phòng ban", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                </div>

                <div class="mb-4">
                    @Html.LabelFor(m => m.Description, "Mô tả", new { @class = "form-label fw-bold" })
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "3" })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                </div>

                <div class="d-flex justify-content-end">
                    <a href="@Url.Action("Departments", "Admin")" class="btn btn-secondary me-2">Hủy</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu Mới</button>
                </div>
            }
        </div>
    </div>
</div>



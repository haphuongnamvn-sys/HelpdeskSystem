@model IEnumerable<HelpdeskSystem.Models.ViewModels.UserManagementVM>

@{
    ViewBag.Title = "Quản lý tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userList = Model.ToList();
}

<div class="container-fluid py-3 px-4">
    
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h1 class="h4 fw-bold text-dark mb-1">Quản lý tài khoản người dùng</h1>
            <p class="text-muted small mb-0">Quản lý danh sách nhân sự, phân quyền vai trò và trạng thái hoạt động.</p>
        </div>
        <div>
            <a href="@Url.Action("UserCreate", "Admin")" class="btn btn-primary btn-sm px-3">
                <i class="fas fa-user-plus me-1"></i> Thêm tài khoản mới
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-3" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    
    <div class="card mb-4 bg-white">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <span class="fw-semibold text-dark">Danh sách người dùng</span>
                <span class="badge bg-light text-secondary border ms-1">@userList.Count</span>
            </div>
            <div style="max-width: 260px; width: 100%;">
                <input type="text" id="userSearchInput" class="form-control form-control-sm" placeholder="Tìm theo tên, email..." />
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="usersTable">
                    <thead>
                        <tr>
                            <th style="width: 32%;">Họ tên &amp; Email</th>
                            <th style="width: 22%;">Phòng ban</th>
                            <th style="width: 18%;">Vai trò</th>
                            <th style="width: 14%;" class="text-center">Trạng thái</th>
                            <th style="width: 14%;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in userList)
                        {
                            <tr class="user-row">
                                <td>
                                    <div class="fw-semibold text-dark">@item.FullName</div>
                                    <div class="text-muted small" style="font-size: 11px;">@item.Email</div>
                                </td>
                                <td>
                                    <span class="small text-dark">@(string.IsNullOrEmpty(item.DepartmentName) ? "Chưa thiết lập" : item.DepartmentName)</span>
                                </td>
                                <td>
                                    @if (item.RoleName == "Admin")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 small">Quản trị viên</span>
                                    }
                                    else if (item.RoleName == "Manager")
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small">Quản lý</span>
                                    }
                                    else if (item.RoleName == "Technician")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1 small">Kỹ thuật viên</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border px-2 py-1 small">Người dùng</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 small">Đã khóa</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex align-items-center justify-content-center gap-1">
                                        <a href="@Url.Action("UserEdit", "Admin", new { id = item.Id })" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Chỉnh sửa">
                                            <i class="fas fa-edit small"></i>
                                        </a>
                                        @using (Html.BeginForm("UserToggleStatus", "Admin", new { id = item.Id }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-secondary py-1 px-2" title="@(item.IsActive ? "Khóa tài khoản" : "Mở khóa")">
                                                <i class="fas @(item.IsActive ? "fa-lock" : "fa-unlock") small"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#userSearchInput').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                $('#usersTable tbody tr.user-row').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
    </script>
}

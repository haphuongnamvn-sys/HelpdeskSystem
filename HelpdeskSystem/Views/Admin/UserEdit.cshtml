@model HelpdeskSystem.Models.ViewModels.UserManagementVM

@{
    ViewBag.Title = "Chỉnh sửa Người Dùng";
}

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Chỉnh sửa Người Dùng: @Model.FullName</h6>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("UserEdit", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.Email)

                <div class="row mb-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.FullName, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", required = "required" })
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold" })
                        <input type="text" class="form-control" value="@Model.Email" disabled />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.SelectedRole, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.SelectedRole, Model.Roles, new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.SelectedRole, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.DepartmentId, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.DepartmentId, Model.Departments, "Chọn phòng ban...", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.DepartmentId, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-check form-switch mt-4">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "IsActiveCheck" })
                            <label class="form-check-label fw-bold" for="IsActiveCheck">Trạng thái Hoạt động</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <a href="@Url.Action("Users", "Admin")" class="btn btn-secondary me-2">Hủy</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu Thay Đổi</button>
                </div>
            }
        </div>
    </div>
</div>



@model IEnumerable<HelpdeskSystem.Models.Domain.Category>

@{
    ViewBag.Title = "Quản lý Danh mục";
    var categoryList = Model.ToList();
}

@section Styles {
    <style>
        #categoriesTable thead th {
            text-align: center !important;
            white-space: nowrap !important;
            font-size: 0.82rem !important;
            font-weight: 700 !important;
            color: #475569 !important;
            background-color: #f8fafc !important;
            border-bottom: 2px solid #e2e8f0 !important;
            padding: 12px 14px !important;
        }
        #categoriesTable tbody td {
            white-space: normal !important;
            word-break: break-word !important;
            vertical-align: middle !important;
            padding: 12px 14px !important;
        }
        #categoriesTable tbody tr:hover {
            background-color: #f8faff !important;
        }
    </style>
}

<div class="content-header">
    <div class="container-fluid">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h1 class="m-0 fw-bold fs-4 text-dark">Danh mục Sự cố</h1>
                <p class="text-muted small mb-0">Phân loại các nhóm sự cố kỹ thuật và liên kết phòng ban phụ trách</p>
            </div>
            <a href="@Url.Action("CategoryCreate", "Admin")" class="btn btn-primary btn-sm px-3 py-2 shadow-sm">
                <i class="fas fa-plus me-1"></i> Thêm danh mục
            </a>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-3" role="alert">
                <i class="fas fa-check-circle me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-dark fw-bold">Danh sách danh mục</span>
                    <span class="badge bg-light text-muted border">@categoryList.Count</span>
                </div>
                <div style="max-width: 280px; width: 100%;">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted small"></i></span>
                        <input type="text" id="catSearchInput" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm danh mục..." />
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="categoriesTable">
                    <thead>
                        <tr>
                            <th class="text-center text-nowrap" style="width: 45%;">DANH MỤC &amp; MÔ TẢ</th>
                            <th class="text-center text-nowrap" style="width: 35%;">PHÒNG BAN PHỤ TRÁCH</th>
                            <th class="text-center text-nowrap" style="width: 20%;">THAO TÁC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (categoryList.Any())
                        {
                            foreach (var item in categoryList)
                            {
                                <tr class="cat-row" style="cursor: pointer;" onclick="location.href='@Url.Action("CategoryEdit", "Admin", new { id = item.CategoryId })'">
                                    <!-- Cột 1: Danh mục & Mô tả (Mỗi mục 1 dòng) -->
                                    <td class="px-3">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-warning flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                                <i class="fas fa-tag"></i>
                                            </div>
                                            <span class="fw-bold text-dark" style="font-size: 0.88rem;">@item.Name</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <div class="text-muted small ps-4 ms-2" style="font-size: 0.78rem; line-height: 1.3;">
                                                @item.Description
                                            </div>
                                        }
                                    </td>

                                    <!-- Cột 2: Phòng ban phụ trách (Căn giữa) -->
                                    <td class="text-center">
                                        @if (item.Department != null)
                                        {
                                            <span class="badge bg-light text-dark border px-2 py-1">
                                                <i class="fas fa-building me-1 text-primary small"></i>@item.Department.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border px-2 py-1">Chung</span>
                                        }
                                    </td>

                                    <!-- Cột 3: Thao tác (Căn giữa) -->
                                    <td class="text-center">
                                        <a href="@Url.Action("CategoryEdit", "Admin", new { id = item.CategoryId })" 
                                           class="btn btn-sm btn-outline-primary px-3 py-1 text-nowrap rounded-2 shadow-none" 
                                           title="Chỉnh sửa danh mục"
                                           onclick="event.stopPropagation();">
                                            <i class="fas fa-pen me-1 small"></i>Sửa
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5 text-muted">
                                    <i class="fas fa-tags fa-3x mb-3 d-block opacity-25"></i>
                                    <span class="fw-semibold">Chưa có danh mục sự cố nào</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#catSearchInput').on('keyup', function() {
                var value = $(this).val().toLowerCase();
                $("#categoriesTable tbody tr.cat-row").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
    </script>
}

@model IEnumerable<HelpdeskSystem.Models.Domain.Category>

@{
    ViewBag.Title = "Quản lý danh mục sự cố";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categoryList = Model.ToList();
}

<div class="container-fluid py-3 px-4">
    
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h1 class="h4 fw-bold text-dark mb-1">Quản lý danh mục sự cố</h1>
            <p class="text-muted small mb-0">Phân loại các nhóm sự cố kỹ thuật và liên kết phòng ban hỗ trợ phụ trách.</p>
        </div>
        <div>
            <a href="@Url.Action("CategoryCreate", "Admin")" class="btn btn-primary btn-sm px-3">
                <i class="fas fa-plus me-1"></i> Thêm danh mục mới
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-3" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    
    <div class="card mb-4 bg-white">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <span class="fw-semibold text-dark">Danh sách danh mục</span>
                <span class="badge bg-light text-secondary border ms-1">@categoryList.Count</span>
            </div>
            <div style="max-width: 260px; width: 100%;">
                <input type="text" id="catSearchInput" class="form-control form-control-sm" placeholder="Tìm theo tên danh mục..." />
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="categoriesTable">
                    <thead>
                        <tr>
                            <th style="width: 45%;">Tên danh mục &amp; Mô tả</th>
                            <th style="width: 35%;">Phòng ban phụ trách</th>
                            <th style="width: 20%;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (categoryList.Any())
                        {
                            foreach (var item in categoryList)
                            {
                                <tr class="cat-row">
                                    <td>
                                        <div class="fw-semibold text-dark">@item.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <div class="text-muted small" style="font-size: 11px;">@item.Description</div>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Department != null)
                                        {
                                            <span class="badge bg-light text-primary border small">
                                                <i class="fas fa-building me-1"></i>@item.Department.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Chung</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a href="@Url.Action("CategoryEdit", "Admin", new { id = item.CategoryId })" class="btn btn-sm btn-outline-secondary py-1 px-3">
                                            <i class="fas fa-edit small me-1"></i> Sửa
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted small">Chưa có danh mục nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#catSearchInput').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                $('#categoriesTable tbody tr.cat-row').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
    </script>
}

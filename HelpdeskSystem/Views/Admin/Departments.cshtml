@model IEnumerable<HelpdeskSystem.Models.Domain.Department>

@{
    ViewBag.Title = "Quản lý phòng ban";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var departmentList = Model.ToList();
}

<div class="container-fluid py-3 px-4">
    
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h1 class="h4 fw-bold text-dark mb-1">Quản lý phòng ban</h1>
            <p class="text-muted small mb-0">Danh sách các phòng ban tiếp nhận và điều phối giải quyết sự cố kỹ thuật.</p>
        </div>
        <div>
            <a href="@Url.Action("DepartmentCreate", "Admin")" class="btn btn-primary btn-sm px-3">
                <i class="fas fa-plus me-1"></i> Thêm phòng ban mới
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-3" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    
    <div class="card mb-4 bg-white">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <span class="fw-semibold text-dark">Danh sách phòng ban</span>
                <span class="badge bg-light text-secondary border ms-1">@departmentList.Count</span>
            </div>
            <div style="max-width: 260px; width: 100%;">
                <input type="text" id="deptSearchInput" class="form-control form-control-sm" placeholder="Tìm theo tên phòng ban..." />
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="departmentsTable">
                    <thead>
                        <tr>
                            <th style="width: 50%;">Tên phòng ban &amp; Mô tả</th>
                            <th style="width: 25%;" class="text-center">Trạng thái</th>
                            <th style="width: 25%;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (departmentList.Any())
                        {
                            foreach (var item in departmentList)
                            {
                                <tr id="row-@item.DepartmentId" class="dept-row">
                                    <td>
                                        <div class="fw-semibold text-dark">@item.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <div class="text-muted small" style="font-size: 11px;">@item.Description</div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 small">Tạm ngưng</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex align-items-center justify-content-center gap-1">
                                            <a href="@Url.Action("DepartmentEdit", "Admin", new { id = item.DepartmentId })" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Chỉnh sửa">
                                                <i class="fas fa-edit small"></i> Sửa
                                            </a>
                                            @using (Html.BeginForm("DepartmentToggleStatus", "Admin", new { id = item.DepartmentId }, FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-secondary py-1 px-2" title="@(item.IsActive ? "Tắt hoạt động" : "Kích hoạt")">
                                                    <i class="fas @(item.IsActive ? "fa-power-off text-danger" : "fa-check text-success") small"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted small">Chưa có phòng ban nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#deptSearchInput').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                $('#departmentsTable tbody tr.dept-row').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
    </script>
}

@model IEnumerable<HelpdeskSystem.Models.Domain.Department>

@{
    ViewBag.Title = "Quản lý Phòng Ban";
    var departmentList = Model.ToList();
}

@section Styles {
    <style>
        #departmentsTable thead th {
            text-align: center !important;
            white-space: nowrap !important;
            font-size: 0.82rem !important;
            font-weight: 700 !important;
            color: #475569 !important;
            background-color: #f8fafc !important;
            border-bottom: 2px solid #e2e8f0 !important;
            padding: 12px 14px !important;
        }
        #departmentsTable tbody td {
            white-space: normal !important;
            word-break: break-word !important;
            vertical-align: middle !important;
            padding: 12px 14px !important;
        }
        #departmentsTable tbody tr:hover {
            background-color: #f8faff !important;
        }
    </style>
}

<div class="content-header">
    <div class="container-fluid">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h1 class="m-0 fw-bold fs-4 text-dark">Phòng Ban</h1>
                <p class="text-muted small mb-0">Danh sách các phòng ban tiếp nhận và xử lý yêu cầu kỹ thuật</p>
            </div>
            <a href="@Url.Action("DepartmentCreate", "Admin")" class="btn btn-primary btn-sm px-3 py-2 shadow-sm">
                <i class="fas fa-plus me-1"></i> Thêm phòng ban
            </a>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-3" role="alert">
                <i class="fas fa-check-circle me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card border-0 shadow-sm">
            <!-- Table Header Toolbar -->
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-dark fw-bold">Danh sách phòng ban</span>
                    <span class="badge bg-light text-muted border">@departmentList.Count</span>
                </div>
                <div style="max-width: 280px; width: 100%;">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted small"></i></span>
                        <input type="text" id="deptSearchInput" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm phòng ban..." />
                    </div>
                </div>
            </div>

            <!-- Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="departmentsTable">
                    <thead>
                        <tr>
                            <th class="text-center text-nowrap" style="width: 50%;">PHÒNG BAN &amp; MÔ TẢ</th>
                            <th class="text-center text-nowrap" style="width: 25%;">TRẠNG THÁI</th>
                            <th class="text-center text-nowrap" style="width: 25%;">THAO TÁC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (departmentList.Any())
                        {
                            foreach (var item in departmentList)
                            {
                                <tr id="row-@item.DepartmentId" class="dept-row" style="cursor: pointer;" onclick="location.href='@Url.Action("DepartmentEdit", "Admin", new { id = item.DepartmentId })'">
                                    <!-- Cột 1: Tên phòng ban & Mô tả (Mỗi mục 1 dòng) -->
                                    <td class="px-3">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-primary flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                                <i class="fas fa-building"></i>
                                            </div>
                                            <span class="fw-bold text-dark" style="font-size: 0.88rem;">@item.Name</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <div class="text-muted small ps-4 ms-2" style="font-size: 0.78rem; line-height: 1.3;">
                                                @item.Description
                                            </div>
                                        }
                                    </td>

                                    <!-- Cột 2: Trạng thái (Căn giữa) -->
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Vô hiệu hóa</span>
                                        }
                                    </td>

                                    <!-- Cột 3: Thao tác (Căn giữa) -->
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-1" onclick="event.stopPropagation();">
                                            <a href="@Url.Action("DepartmentEdit", "Admin", new { id = item.DepartmentId })" 
                                               class="btn btn-sm btn-outline-primary px-3 py-1 text-nowrap rounded-2 shadow-none" 
                                               title="Chỉnh sửa phòng ban">
                                                <i class="fas fa-pen me-1 small"></i>Sửa
                                            </a>
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-danger px-2 py-1 text-nowrap rounded-2 shadow-none btn-delete-dept" 
                                                    data-id="@item.DepartmentId" 
                                                    title="Xóa phòng ban">
                                                <i class="far fa-trash-alt small"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5 text-muted">
                                    <i class="fas fa-building fa-3x mb-3 d-block opacity-25"></i>
                                    <span class="fw-semibold">Chưa có phòng ban nào</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Live instant search without clunky DataTables UI
            $('#deptSearchInput').on('keyup', function() {
                var value = $(this).val().toLowerCase();
                $("#departmentsTable tbody tr.dept-row").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            $('.btn-delete-dept').click(function(e) {
                e.stopPropagation();
                if(confirm("Bạn có chắc chắn muốn xóa phòng ban này?")) {
                    var id = $(this).data('id');
                    $.ajax({
                        url: '@Url.Action("DepartmentDelete", "Admin")',
                        type: 'POST',
                        data: { id: id },
                        success: function(res) {
                            if(res.success) {
                                location.reload();
                            } else {
                                alert("Có lỗi xảy ra: " + (res.message || "Không thể xóa"));
                            }
                        }
                    });
                }
            });
        });
    </script>
}

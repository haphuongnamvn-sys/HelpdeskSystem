@model IEnumerable<HelpdeskSystem.Models.Domain.SLAConfig>

@{
    ViewBag.Title = "Cấu hình cam kết SLA";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var configs = Model.ToList();
}

<div class="container-fluid py-3 px-4">
    
    <div class="mb-3">
        <h1 class="h4 fw-bold text-dark mb-1">Cấu hình cam kết dịch vụ (SLA)</h1>
        <p class="text-muted small mb-0">Thiết lập thời hạn tối đa phản hồi ban đầu và giải quyết hoàn tất sự cố theo từng mức ưu tiên.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-3" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    
    <div class="card mb-4 bg-white">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
            <span class="fw-semibold text-dark">Định mức thời gian theo mức ưu tiên</span>
            <span class="badge bg-light text-secondary border">@configs.Count cấp độ</span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="slaTable">
                    <thead>
                        <tr>
                            <th style="width: 25%;" class="text-center">Mức độ ưu tiên</th>
                            <th style="width: 25%;" class="text-center">Thời gian phản hồi</th>
                            <th style="width: 25%;" class="text-center">Thời gian giải quyết</th>
                            <th style="width: 15%;" class="text-center">Ngưỡng cảnh báo</th>
                            <th style="width: 10%;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var config in configs)
                        {
                            using (Html.BeginForm("SLAConfigSave", "Admin", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <tr>
                                    <td class="text-center">
                                        <input type="hidden" name="SLAConfigId" value="@config.SLAConfigId" />
                                        <input type="hidden" name="PriorityId" value="@config.PriorityId" />
                                        @if (config.Priority != null)
                                        {
                                            <span class="badge px-3 py-1 small fw-semibold" style="background-color: @config.Priority.ColorCode; color: white;">
                                                @config.Priority.Name
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="input-group input-group-sm mx-auto" style="max-width: 120px;">
                                            <input type="number" name="ResponseTimeHours" value="@config.ResponseTimeHours" class="form-control text-center fw-semibold" min="1" required />
                                            <span class="input-group-text bg-light text-muted">giờ</span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="input-group input-group-sm mx-auto" style="max-width: 120px;">
                                            <input type="number" name="ResolutionTimeHours" value="@config.ResolutionTimeHours" class="form-control text-center fw-semibold" min="1" required />
                                            <span class="input-group-text bg-light text-muted">giờ</span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="input-group input-group-sm mx-auto" style="max-width: 100px;">
                                            <input type="number" name="WarningThresholdPercent" value="@config.WarningThresholdPercent" class="form-control text-center fw-semibold" min="1" max="100" required />
                                            <span class="input-group-text bg-light text-muted">%</span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <button type="submit" class="btn btn-sm btn-outline-primary px-3">
                                            <i class="fas fa-save me-1"></i> Lưu
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

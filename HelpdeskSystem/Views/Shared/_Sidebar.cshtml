@using Microsoft.AspNet.Identity
@{
    string controller = ViewContext.RouteData.Values["controller"] != null ? ViewContext.RouteData.Values["controller"].ToString() : "";
    string action = ViewContext.RouteData.Values["action"] != null ? ViewContext.RouteData.Values["action"].ToString() : "";
    bool isAdmin = User.IsInRole("Admin");
    bool isManager = User.IsInRole("Manager");
    bool isTech = User.IsInRole("Technician");
    bool isUser = !isAdmin && !isManager && !isTech;

    var identity = User.Identity as System.Security.Claims.ClaimsIdentity;
    var fullNameObj = identity != null ? identity.FindFirst("FullName") : null;
    string fullNameClaim = fullNameObj != null ? fullNameObj.Value : null;
    string userDisplayName = !string.IsNullOrWhiteSpace(fullNameClaim) ? fullNameClaim : User.Identity.GetUserName();
    string userEmail = User.Identity.GetUserName();
    if (!string.IsNullOrEmpty(userDisplayName) && userDisplayName.Contains("@"))
    {
        userDisplayName = userDisplayName.Substring(0, userDisplayName.IndexOf("@"));
    }
}

<!-- User Profile Panel (Bấm vào để xem hồ sơ cá nhân) -->
<div class="user-panel">
    <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(userDisplayName)&background=1F5FBF&color=fff&bold=true&size=64" alt="User Avatar">
    <div class="info text-truncate">
        <a href="@Url.Action("Profile", "Account")" class="d-block text-white text-decoration-none fw-bold" title="@userEmail">
            @userDisplayName
        </a>
        <div class="mt-1">
            @if (isAdmin) { <span class="badge bg-danger text-white">Quản trị viên</span> }
            else if (isManager) { <span class="badge bg-primary text-white">Quản lý</span> }
            else if (isTech) { <span class="badge bg-warning text-dark">Kỹ thuật viên</span> }
            else { <span class="badge bg-info text-dark">Người dùng</span> }
        </div>
    </div>
</div>

<!-- Navigation Menu chuẩn theo Biểu đồ Use Case -->
<nav class="mt-3 flex-grow-1">
    <ul class="nav flex-column">

        @* 1. QUẢN TRỊ VIÊN (ADMIN) *@
        @if (isAdmin)
        {
            <div class="sidebar-section-title">Quản trị hệ thống</div>
            <li class="nav-item">
                <a href="@Url.Action("Users", "Admin")" class="nav-link @(controller == "Admin" && action.StartsWith("User") ? "active" : "")">
                    <i class="fas fa-users-cog"></i>
                    <span>Quản lý tài khoản</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("Departments", "Admin")" class="nav-link @(controller == "Admin" && action.StartsWith("Department") ? "active" : "")">
                    <i class="fas fa-sitemap"></i>
                    <span>Quản lý phòng ban</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("Categories", "Admin")" class="nav-link @(controller == "Admin" && action.StartsWith("Category") ? "active" : "")">
                    <i class="fas fa-tags"></i>
                    <span>Quản lý danh mục sự cố</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("SLAConfig", "Admin")" class="nav-link @(controller == "Admin" && action == "SLAConfig" ? "active" : "")">
                    <i class="fas fa-stopwatch"></i>
                    <span>Thiết lập mức ưu tiên</span>
                </a>
            </li>

            <div class="sidebar-section-title">Cơ sở tri thức</div>
            <li class="nav-item">
                <a href="@Url.Action("Index", "KnowledgeBase")" class="nav-link @(controller == "KnowledgeBase" ? "active" : "")">
                    <i class="fas fa-book-open"></i>
                    <span>Tra cứu cơ sở tri thức</span>
                </a>
            </li>
        }

        @* 2. QUẢN LÝ (MANAGER) *@
        @if (isManager)
        {
            <div class="sidebar-section-title">Quản lý phiếu</div>
            <li class="nav-item">
                <a href="@Url.Action("Index", "Ticket")" class="nav-link @(controller == "Ticket" ? "active" : "")">
                    <i class="fas fa-ticket-alt"></i>
                    <span>Quản lý phiếu người dùng</span>
                </a>
            </li>

            <div class="sidebar-section-title">Cơ sở tri thức</div>
            <li class="nav-item">
                <a href="@Url.Action("Index", "KnowledgeBase")" class="nav-link @(controller == "KnowledgeBase" && (action == "Index" || action == "Details") ? "active" : "")">
                    <i class="fas fa-book-open"></i>
                    <span>Tra cứu cơ sở tri thức</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("Manage", "KnowledgeBase")" class="nav-link @(controller == "KnowledgeBase" && action != "Index" && action != "Details" ? "active" : "")">
                    <i class="fas fa-folder-plus"></i>
                    <span>Quản lý cơ sở tri thức</span>
                </a>
            </li>

            <div class="sidebar-section-title">Thống kê</div>
            <li class="nav-item">
                <a href="@Url.Action("Index", "Report")" class="nav-link @(controller == "Report" ? "active" : "")">
                    <i class="fas fa-chart-line"></i>
                    <span>Xem báo cáo thống kê</span>
                </a>
            </li>
        }

        @* 3. NHÂN VIÊN PHỤ TRÁCH (TECHNICIAN) *@
        @if (isTech)
        {
            <div class="sidebar-section-title">Quản lý phiếu</div>
            <li class="nav-item">
                <a href="@Url.Action("Index", "Ticket")" class="nav-link @(controller == "Ticket" ? "active" : "")">
                    <i class="fas fa-tasks"></i>
                    <span>Phiếu được giao</span>
                </a>
            </li>

            <div class="sidebar-section-title">Cơ sở tri thức</div>
            <li class="nav-item">
                <a href="@Url.Action("Index", "KnowledgeBase")" class="nav-link @(controller == "KnowledgeBase" && (action == "Index" || action == "Details") ? "active" : "")">
                    <i class="fas fa-book-open"></i>
                    <span>Tra cứu cơ sở tri thức</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("Manage", "KnowledgeBase")" class="nav-link @(controller == "KnowledgeBase" && action != "Index" && action != "Details" ? "active" : "")">
                    <i class="fas fa-folder-plus"></i>
                    <span>Quản lý cơ sở tri thức</span>
                </a>
            </li>
        }

        @* 4. NGƯỜI DÙNG (END USER) *@
        @if (isUser)
        {
            <div class="sidebar-section-title">Phiếu cá nhân</div>
            <li class="nav-item">
                <a href="@Url.Action("Index", "Ticket")" class="nav-link @(controller == "Ticket" && action == "Index" ? "active" : "")">
                    <i class="fas fa-ticket-alt"></i>
                    <span>Phiếu của tôi</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("Create", "Ticket")" class="nav-link @(controller == "Ticket" && action == "Create" ? "active" : "")">
                    <i class="fas fa-plus-circle text-primary"></i>
                    <span>Tạo phiếu yêu cầu</span>
                </a>
            </li>

            <div class="sidebar-section-title">Cơ sở tri thức</div>
            <li class="nav-item">
                <a href="@Url.Action("Index", "KnowledgeBase")" class="nav-link @(controller == "KnowledgeBase" && (action == "Index" || action == "Details") ? "active" : "")">
                    <i class="fas fa-book-open"></i>
                    <span>Tra cứu cơ sở tri thức</span>
                </a>
            </li>
        }

    </ul>
</nav>

<!-- Sidebar Footer: Đăng xuất -->
<div class="sidebar-footer">
    @if (Request.IsAuthenticated)
    {
        <a href="@Url.Action("LogOff", "Account")"
           class="d-flex align-items-center justify-content-center text-decoration-none py-2 small"
           style="color: #94a3b8; transition: color 0.15s ease;"
           onmouseover="this.style.color='#f87171'" onmouseout="this.style.color='#94a3b8'"
           onclick="return confirm('Bạn có chắc chắn muốn đăng xuất không?');">
            <i class="fas fa-sign-out-alt me-2 text-danger"></i>
            <span>Đăng xuất</span>
        </a>
    }
    else
    {
        <a href="@Url.Action("Login", "Account")" class="btn btn-primary btn-sm w-100 fw-semibold">
            <i class="fas fa-sign-in-alt me-1"></i> Đăng nhập
        </a>
    }
</div>

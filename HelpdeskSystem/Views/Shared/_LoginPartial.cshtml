@using Microsoft.AspNet.Identity
@if (Request.IsAuthenticated)
{
    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "d-none" }))
    {
        @Html.AntiForgeryToken()
    }

    <!-- Chuông thông báo Realtime -->
    <li class="nav-item dropdown me-2">
        <a class="nav-link position-relative p-2" href="#" id="notificationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Thông báo hệ thống">
            <i class="far fa-bell fa-lg text-secondary"></i>
            <span class="badge bg-danger rounded-pill navbar-badge" id="notificationCount" style="display:none;">0</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-0" aria-labelledby="notificationDropdown" id="notificationList" style="min-width: 320px;">
            <li class="p-3 bg-light border-bottom fw-bold text-dark">
                <i class="fas fa-bell me-1 text-primary"></i> Thông báo mới
            </li>
            <li><span class="dropdown-item py-3 text-center text-muted small">Đang kiểm tra...</span></li>
            <li class="border-top text-center p-2">
                <small class="text-muted">Tự động cập nhật mỗi 30 giây</small>
            </li>
        </ul>
    </li>

    <!-- User Profile Dropdown -->
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center p-1 px-2 border rounded-pill bg-light" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <img src="https://ui-avatars.com/api/?name=@(User.Identity.GetUserName())&background=2563eb&color=fff&size=64" class="rounded-circle me-2" width="28" height="28" alt="Avatar">
            <span class="fw-semibold text-dark me-1" style="font-size: 0.9rem;">
                @(User.Identity.GetUserName())
            </span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2 py-2" aria-labelledby="userDropdown" style="min-width: 240px; border-radius: 10px;">
            <li class="px-3 py-2 border-bottom mb-1">
                <div class="fw-bold text-dark text-truncate">@(User.Identity.GetUserName())</div>
                <small class="text-muted">
                    @if (User.IsInRole("Admin")) { <span class="badge bg-danger">Quản trị viên</span> }
                    else if (User.IsInRole("Technician")) { <span class="badge bg-warning text-dark">Kỹ thuật viên</span> }
                    else { <span class="badge bg-info">Người dùng</span> }
                </small>
            </li>
            <li>
                <a class="dropdown-item py-2" href="@Url.Action("Profile", "Account")">
                    <i class="fas fa-user-circle fa-fw text-primary me-2"></i> Hồ sơ cá nhân
                </a>
            </li>
            <li>
                <a class="dropdown-item py-2" href="@Url.Action("ChangePassword", "Account")">
                    <i class="fas fa-key fa-fw text-secondary me-2"></i> Đổi mật khẩu
                </a>
            </li>
            <li><hr class="dropdown-divider my-1"></li>
            <li>
                <a class="dropdown-item py-2 text-danger fw-bold" href="javascript:void(0);" onclick="if(confirm('Bạn có chắc chắn muốn đăng xuất không?')) { document.getElementById('logoutForm').submit(); }">
                    <i class="fas fa-sign-out-alt fa-fw me-2"></i> Đăng xuất
                </a>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item me-2">
        <a href="@Url.Action("Register", "Account")" class="btn btn-outline-primary btn-sm px-3">
            <i class="fas fa-user-plus me-1"></i> Đăng ký
        </a>
    </li>
    <li class="nav-item">
        <a href="@Url.Action("Login", "Account")" class="btn btn-primary btn-sm px-3">
            <i class="fas fa-sign-in-alt me-1"></i> Đăng nhập
        </a>
    </li>
}

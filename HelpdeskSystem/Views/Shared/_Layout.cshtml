<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Helpdesk Pro</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <!-- DataTables Bootstrap 5 -->
    <link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <!-- Custom Theme -->
    <link href="~/Content/Site.css?v=@DateTime.Now.Ticks" rel="stylesheet">
    @RenderSection("Styles", required: false)
    <style>
        /* Auth modal overlay for login page link */
        .auth-form-box { max-width: 480px; }
    </style>
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <aside class="main-sidebar" id="sidebar">
            <a href="~/" class="sidebar-brand">
                <i class="fas fa-headset"></i>
                <span>Helpdesk Pro</span>
            </a>
            @Html.Partial("_Sidebar")
        </aside>

        <!-- Main Panel -->
        <div class="main-panel">
            <!-- Top Navbar -->
            <nav class="navbar navbar-expand navbar-light main-header">
                <div class="container-fluid px-0">
                    <button type="button" id="sidebarCollapse" title="Mở/Đóng Menu">
                        <i class="fas fa-bars"></i>
                    </button>

                    <div class="d-none d-md-flex align-items-center ms-3" style="color:#8fa3bc;font-size:0.88rem">
                        <i class="fas fa-circle-dot text-success me-2" style="font-size:0.65rem"></i>
                        Hệ thống đang hoạt động bình thường
                    </div>

                    <ul class="navbar-nav ms-auto align-items-center">
                        @Html.Partial("_LoginPartial")
                    </ul>
                </div>
            </nav>

            <!-- Flash Alerts -->
            <div class="px-4 pt-3">
                @if (TempData["Success"] != null || TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-3" role="alert">
                        <i class="fas fa-check-circle fa-lg flex-shrink-0"></i>
                        <div><strong>Thành công!</strong> @(TempData["Success"] ?? TempData["SuccessMessage"])</div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null || TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-3" role="alert">
                        <i class="fas fa-exclamation-triangle fa-lg flex-shrink-0"></i>
                        <div><strong>Lỗi:</strong> @(TempData["Error"] ?? TempData["ErrorMessage"])</div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                    </div>
                }
            </div>

            <!-- Page Content -->
            <div class="content">
                <div class="container-fluid px-0">
                    @RenderBody()
                </div>
            </div>

            <!-- Footer -->
            <footer class="main-footer">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <i class="fas fa-headset text-primary me-1"></i>
                        <strong>Helpdesk Pro</strong> &mdash; Hệ thống quản lý yêu cầu hỗ trợ kỹ thuật
                    </div>
                    <div class="text-muted small">Phiên bản v2.0 &copy; 2026</div>
                </div>
            </footer>
        </div>
    </div>

    <!-- jQuery 3.7 -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            // Sidebar toggle
            $('#sidebarCollapse').on('click', function () {
                $('#sidebar').toggleClass('collapsed');
            });
            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                $('.alert.fade.show').alert('close');
            }, 5000);
        });
    </script>

    <!-- Notification Polling Script -->
    <script src="~/Scripts/notification-polling.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

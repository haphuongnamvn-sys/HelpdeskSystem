<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Helpdesk Pro</title>
    <!-- Google Fonts: Be Vietnam Pro -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <!-- DataTables Bootstrap 5 -->
    <link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <!-- Custom Theme -->
    <link href="~/Content/Site.css?v=@DateTime.Now.Ticks" rel="stylesheet">
    @RenderSection("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100 bg-page">
    <!-- Header & Menu ngang cố định ở đầu (Chamtoeic Style) -->
    <header class="app-header sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-2" style="border-color: #D9DEE5 !important;">
            <div class="container-fluid px-3 px-lg-4">
                <!-- Brand Logo -->
                <a class="navbar-brand d-flex align-items-center me-3 me-xl-4 text-decoration-none" href="~/">
                    <div class="brand-icon-box me-2">
                        <i class="fas fa-headset text-white"></i>
                    </div>
                    <span class="brand-title">Helpdesk<span class="text-primary">Pro</span></span>
                </a>

                <!-- Mobile Hamburger Toggle -->
                <button class="navbar-toggler border-0 p-1" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fas fa-bars fa-lg text-secondary"></i>
                </button>

                <!-- Navbar Collapse: Menu ngang ở giữa + User actions bên phải -->
                <div class="collapse navbar-collapse" id="navbarMain">
                    <!-- Menu ngang theo vai trò -->
                    @Html.Partial("_HeaderMenu")

                    <!-- Phía phải: Thông báo & Tài khoản -->
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2 pt-2 pt-lg-0">
                        @Html.Partial("_LoginPartial")
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content ở giữa -->
    <main class="app-main flex-grow-1">
        <!-- Flash Alerts -->
        <div class="container-fluid px-3 px-lg-4 pt-3">
            @if (TempData["Success"] != null || TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3 py-2 small" role="alert">
                    <i class="fas fa-check-circle flex-shrink-0 text-success"></i>
                    <div><strong>Thành công!</strong> @(TempData["Success"] ?? TempData["SuccessMessage"])</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null || TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3 py-2 small" role="alert">
                    <i class="fas fa-exclamation-triangle flex-shrink-0 text-danger"></i>
                    <div><strong>Lỗi:</strong> @(TempData["Error"] ?? TempData["ErrorMessage"])</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>

        <!-- Nội dung trang -->
        <div class="content pb-4">
            @RenderBody()
        </div>
    </main>

    <!-- Footer ở cuối -->
    <footer class="app-footer border-top bg-white py-3 mt-auto" style="border-color: #D9DEE5 !important;">
        <div class="container-fluid px-3 px-lg-4 d-flex justify-content-between align-items-center flex-wrap gap-2 text-muted small">
            <div>
                <strong>Helpdesk Pro</strong> &mdash; Hệ thống Tiếp nhận &amp; Hỗ trợ Kỹ thuật Nội bộ
            </div>
            <div>
                Đồ án Chuyên ngành Công nghệ Thông tin &bull; &copy; 2026
            </div>
        </div>
    </footer>

    <!-- jQuery 3.7 -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            // Tự động đóng thông báo sau 5 giây
            setTimeout(function () {
                $('.alert.fade.show').alert('close');
            }, 5000);
        });
    </script>

    <!-- Notification Polling Script -->
    <script src="~/Scripts/notification-polling.js"></script>

    <!-- Messenger Floating Chatbot Widget (dành cho Người dùng, Nhân viên phụ trách, Quản lý) -->
    @if (Request.IsAuthenticated && !User.IsInRole("Admin"))
    {
        @Html.Partial("_ChatbotMessenger")
    }

    @RenderSection("Scripts", required: false)
</body>
</html>

@model HelpdeskSystem.Models.Domain.KnowledgeBase

@{
    ViewBag.Title = "Thêm bài viết Tri thức mới";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Thêm bài viết hướng dẫn mới</h1>
            </div>
            <div class="col-sm-6 text-end">
                <a href="@Url.Action("Manage", "KnowledgeBase")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Trở lại
                </a>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h6 class="m-0 fw-bold">Nội dung bài viết</h6>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("Create", "KnowledgeBase", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger alert alert-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Title, "Tiêu đề bài viết", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "Ví dụ: Hướng dẫn cài đặt máy in mạng văn phòng...", required = "required" })
                        @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.CategoryId, "Chuyên mục", new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.CategoryId, (SelectList)ViewBag.Categories, "-- Chọn chuyên mục --", new { @class = "form-select", required = "required" })
                        @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(m => m.Content, "Nội dung chi tiết (hỗ trợ HTML)", new { @class = "form-label fw-bold" })
                        @Html.TextAreaFor(m => m.Content, new { @class = "form-control", rows = "12", placeholder = "Nhập nội dung các bước thực hiện, giải pháp xử lý sự cố...", required = "required" })
                        <small class="text-muted">Bạn có thể sử dụng các thẻ HTML cơ bản như &lt;b&gt;, &lt;p&gt;, &lt;ul&gt;, &lt;li&gt;, &lt;ol&gt;, &lt;img&gt; để định dạng bài viết.</small>
                        @Html.ValidationMessageFor(m => m.Content, "", new { @class = "text-danger" })
                    </div>

                    <div class="d-flex justify-content-end">
                        <a href="@Url.Action("Manage", "KnowledgeBase")" class="btn btn-secondary me-2">Hủy</a>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane me-1"></i> Xuất bản bài viết</button>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

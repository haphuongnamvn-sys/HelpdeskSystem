@model IEnumerable<HelpdeskSystem.Models.Domain.KnowledgeBase>

@{
    ViewBag.Title = "Quản lý cơ sở tri thức";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var kbList = Model != null ? Model.ToList() : new List<HelpdeskSystem.Models.Domain.KnowledgeBase>();
}

<div class="container-fluid py-3 px-4">
    
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h1 class="h4 fw-bold text-dark mb-1">Quản lý cơ sở tri thức</h1>
            <p class="text-muted small mb-0">Quản lý kho bài viết hướng dẫn xử lý sự cố kỹ thuật và cẩm nang người dùng.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "KnowledgeBase")" class="btn btn-outline-secondary btn-sm px-3">
                <i class="fas fa-eye me-1"></i> Xem giao diện người dùng
            </a>
            <a href="@Url.Action("Create", "KnowledgeBase")" class="btn btn-primary btn-sm px-3">
                <i class="fas fa-plus me-1"></i> Viết bài mới
            </a>
        </div>
    </div>

    <!-- Bảng danh sách bài viết -->
    <div class="card mb-4 bg-white">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <span class="fw-semibold text-dark">Danh sách bài viết</span>
                <span class="badge bg-light text-secondary border ms-1">@kbList.Count</span>
            </div>
            <div style="max-width: 260px; width: 100%;">
                <input type="text" id="kbSearchInput" class="form-control form-control-sm" placeholder="Tìm theo tiêu đề..." />
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="kbTable">
                    <thead>
                        <tr>
                            <th style="width: 45%;">Tiêu đề bài viết</th>
                            <th style="width: 18%;">Danh mục</th>
                            <th style="width: 15%;">Lượt xem &amp; Đánh giá</th>
                            <th style="width: 12%;" class="text-center">Trạng thái</th>
                            <th style="width: 10%;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (kbList.Any())
                        {
                            foreach (var item in kbList)
                            {
                                <tr class="kb-row">
                                    <td>
                                        <a href="@Url.Action("Details", "KnowledgeBase", new { id = item.ArticleId })" class="fw-semibold text-primary text-decoration-none">
                                            @item.Title
                                        </a>
                                        <div class="text-muted small" style="font-size: 11px;">
                                            Đăng ngày @item.CreatedDate.ToString("dd/MM/yyyy") bởi @(item.CreatedBy != null ? item.CreatedBy.FullName : "Admin")
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-secondary border small">
                                            @(item.Category != null ? item.Category.Name : "Chung")
                                        </span>
                                    </td>
                                    <td class="small text-muted">
                                        <div><i class="far fa-eye me-1"></i>@item.ViewCount lượt xem</div>
                                        <div class="text-success" style="font-size: 11px;">
                                            <i class="far fa-thumbs-up me-1"></i>@item.HelpfulCount hữu ích
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @if (item.IsVisible)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">Hiển thị</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 small">Đang ẩn</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex align-items-center justify-content-center gap-1">
                                            <a href="@Url.Action("Edit", "KnowledgeBase", new { id = item.ArticleId })" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Chỉnh sửa">
                                                <i class="fas fa-edit small"></i>
                                            </a>
                                            @using (Html.BeginForm("ToggleVisibility", "KnowledgeBase", new { id = item.ArticleId }, FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-secondary py-1 px-2" title="@(item.IsVisible ? "Ẩn bài viết" : "Hiển thị bài viết")">
                                                    <i class="fas @(item.IsVisible ? "fa-eye-slash" : "fa-eye") small"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted small">Chưa có bài viết nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#kbSearchInput').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                $('#kbTable tbody tr.kb-row').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
    </script>
}

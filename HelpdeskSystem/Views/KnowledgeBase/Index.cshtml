@model IEnumerable<HelpdeskSystem.Models.Domain.KnowledgeBase>

@{
    ViewBag.Title = "Cơ sở tri thức & Hướng dẫn";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categories = ViewBag.Categories as IEnumerable<HelpdeskSystem.Models.Domain.Category> ?? new List<HelpdeskSystem.Models.Domain.Category>();
    var popular = ViewBag.PopularArticles as IEnumerable<HelpdeskSystem.Models.Domain.KnowledgeBase> ?? new List<HelpdeskSystem.Models.Domain.KnowledgeBase>();
    string currentSearch = ViewBag.Search as string ?? "";
    int? currentCat = ViewBag.SelectedCategory as int?;
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-book-reader text-primary me-2"></i>Cơ sở tri thức (FAQ)</h1>
            </div>
            <div class="col-sm-6 text-end">
                @if (User.IsInRole("Admin") || User.IsInRole("Technician"))
                {
                    <a href="@Url.Action("Manage", "KnowledgeBase")" class="btn btn-outline-primary">
                        <i class="fas fa-cog"></i> Quản lý bài viết
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Hero Search Box -->
        <div class="card bg-primary text-white mb-4 shadow-sm">
            <div class="card-body p-4 text-center">
                <h3 class="fw-bold mb-2">Chúng tôi có thể giúp gì cho bạn?</h3>
                <p class="mb-3 text-white-50">Tìm kiếm các hướng dẫn xử lý sự cố thường gặp trước khi gửi phiếu yêu cầu</p>
                <form method="get" action="@Url.Action("Index", "KnowledgeBase")" class="d-flex justify-content-center">
                    <div class="input-group" style="max-width: 600px;">
                        <input type="text" name="search" class="form-control form-control-lg" placeholder="Nhập từ khóa (máy in, mật khẩu, wifi, v.v.)..." value="@currentSearch" />
                        <button type="submit" class="btn btn-light btn-lg px-4"><i class="fas fa-search text-primary"></i> Tìm</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="row">
            <!-- Sidebar: Danh mục & Bài xem nhiều -->
            <div class="col-md-4 mb-4">
                <!-- Danh mục -->
                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-light">
                        <h6 class="m-0 fw-bold"><i class="fas fa-folder me-2 text-warning"></i>Chủ đề theo danh mục</h6>
                    </div>
                    <div class="list-group list-group-flush">
                        <a href="@Url.Action("Index", "KnowledgeBase")" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(!currentCat.HasValue ? "active" : "")">
                            <span>Tất cả danh mục</span>
                        </a>
                        @foreach (var cat in categories)
                        {
                            <a href="@Url.Action("Index", "KnowledgeBase", new { categoryId = cat.CategoryId })" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(currentCat == cat.CategoryId ? "active" : "")">
                                <span>@cat.Name</span>
                                <span class="badge bg-secondary rounded-pill">@(cat.Tickets != null ? cat.Tickets.Count : 0)</span>
                            </a>
                        }
                    </div>
                </div>

                <!-- Bài viết xem nhiều -->
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h6 class="m-0 fw-bold"><i class="fas fa-fire me-2 text-danger"></i>Bài viết xem nhiều nhất</h6>
                    </div>
                    <div class="list-group list-group-flush">
                        @if (popular.Any())
                        {
                            foreach (var p in popular)
                            {
                                <a href="@Url.Action("Details", "KnowledgeBase", new { id = p.ArticleId })" class="list-group-item list-group-item-action">
                                    <div class="fw-bold text-dark">@p.Title</div>
                                    <small class="text-muted"><i class="fas fa-eye me-1"></i>@p.ViewCount lượt xem</small>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="p-3 text-muted text-center">Chưa có bài viết nổi bật.</div>
                        }
                    </div>
                </div>
            </div>

            <!-- Danh sách bài viết -->
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h6 class="m-0 fw-bold">Danh sách bài viết hướng dẫn (@Model.Count())</h6>
                        @if (!string.IsNullOrEmpty(currentSearch) || currentCat.HasValue)
                        {
                            <a href="@Url.Action("Index", "KnowledgeBase")" class="text-decoration-none small text-danger">
                                <i class="fas fa-times-circle"></i> Xóa bộ lọc
                            </a>
                        }
                    </div>
                    <div class="card-body">
                        @if (Model.Any())
                        {
                            <div class="row g-3">
                                @foreach (var item in Model)
                                {
                                    <div class="col-12">
                                        <div class="card h-100 border-start border-4 border-primary">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="badge bg-info text-dark">@(item.Category != null ? item.Category.Name : "Chung")</span>
                                                    <small class="text-muted"><i class="fas fa-eye me-1"></i>@item.ViewCount lượt xem</small>
                                                </div>
                                                <h5 class="card-title fw-bold mt-2">
                                                    <a href="@Url.Action("Details", "KnowledgeBase", new { id = item.ArticleId })" class="text-decoration-none text-dark">
                                                        @item.Title
                                                    </a>
                                                </h5>
                                                <p class="card-text text-muted small mt-2">
                                                    @{
                                                        string plainText = System.Text.RegularExpressions.Regex.Replace(item.Content ?? "", "<.*?>", string.Empty);
                                                        string snippet = plainText.Length > 150 ? plainText.Substring(0, 150) + "..." : plainText;
                                                    }
                                                    @snippet
                                                </p>
                                                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                                    <small class="text-muted">Cập nhật: @(item.UpdatedDate.HasValue ? item.UpdatedDate.Value.ToString("dd/MM/yyyy") : item.CreatedDate.ToString("dd/MM/yyyy"))</small>
                                                    <a href="@Url.Action("Details", "KnowledgeBase", new { id = item.ArticleId })" class="btn btn-sm btn-outline-primary">
                                                        Xem hướng dẫn <i class="fas fa-arrow-right ms-1"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="fas fa-search fa-3x mb-3 text-secondary"></i>
                                <h5>Không tìm thấy bài viết nào phù hợp</h5>
                                <p class="small">Hãy thử tìm với từ khóa khác hoặc gửi yêu cầu hỗ trợ cho kỹ thuật viên.</p>
                                <a href="@Url.Action("Create", "Ticket")" class="btn btn-primary btn-sm mt-2">
                                    <i class="fas fa-plus-circle"></i> Tạo phiếu hỗ trợ ngay
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

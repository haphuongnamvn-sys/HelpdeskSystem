@model HelpdeskSystem.Models.ViewModels.RegisterViewModel
@{
    ViewBag.Title = "Đăng ký tài khoản";
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
}

<div class="auth-card">
    <h2 class="h5 fw-bold text-dark mb-1">Đăng ký tài khoản</h2>
    <p class="text-muted small mb-4">Tạo tài khoản để gửi và theo dõi các yêu cầu hỗ trợ kỹ thuật</p>

    @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
    {
        @Html.AntiForgeryToken()
        
        if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary-errors">
                @Html.ValidationSummary(true, "", new { @class = "list-unstyled mb-0" })
            </div>
        }

        <div class="mb-3">
            @Html.LabelFor(m => m.FullName, "Họ và tên", new { @class = "form-label" })
            <div class="input-group">
                <span class="input-group-text"><i class="far fa-user"></i></span>
                @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Nguyễn Văn A" })
            </div>
            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "field-validation-error" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Email, "Địa chỉ Email", new { @class = "form-label" })
            <div class="input-group">
                <span class="input-group-text"><i class="far fa-envelope"></i></span>
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "name@company.com", autocomplete = "username" })
            </div>
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.PhoneNumber, "Số điện thoại", new { @class = "form-label" })
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-phone small"></i></span>
                @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "0912 345 678" })
            </div>
            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "field-validation-error" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Password, "Mật khẩu", new { @class = "form-label" })
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-lock small"></i></span>
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Tối thiểu 6 ký tự", autocomplete = "new-password" })
            </div>
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
        </div>

        <div class="mb-4">
            @Html.LabelFor(m => m.ConfirmPassword, "Xác nhận mật khẩu", new { @class = "form-label" })
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-lock small"></i></span>
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Nhập lại mật khẩu để xác nhận", autocomplete = "new-password" })
            </div>
            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-validation-error" })
        </div>

        <div class="d-grid mb-3">
            <button type="submit" class="btn btn-primary">
                Đăng ký tài khoản
            </button>
        </div>
    }

    <div class="text-center pt-2 border-top" style="border-color: #D9DEE5 !important;">
        <span class="text-muted small">Đã có tài khoản?</span>
        <a href="@Url.Action("Login", "Account")" class="small fw-semibold ms-1 text-decoration-none">Đăng nhập</a>
    </div>
</div>

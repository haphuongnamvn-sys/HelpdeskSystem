@model HelpdeskSystem.Models.ViewModels.ReportViewModel
@{
    ViewBag.Title = "Báo cáo & Thống kê";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-3 px-4">
    <!-- Breadcrumb & Tiêu đề -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h1 class="h4 fw-bold text-dark mb-1">Báo cáo &amp; Thống kê hiệu suất</h1>
            <p class="text-muted small mb-0">Theo dõi khối lượng yêu cầu, tiến độ xử lý và tỷ lệ tuân thủ cam kết SLA.</p>
        </div>
    </div>

    <!-- Bộ lọc báo cáo & Xuất Excel -->
    <div class="card mb-4 bg-white">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
            <span class="fw-semibold text-dark">Bộ lọc báo cáo</span>
            <span class="text-muted small">Thời gian và điều kiện thống kê</span>
        </div>
        <div class="card-body p-3">
            @using (Html.BeginForm("Index", "Report", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
            {
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-dark mb-1">Từ ngày</label>
                    @Html.TextBoxFor(m => m.FromDate, "{0:yyyy-MM-dd}", new { @class = "form-control form-control-sm", type = "date" })
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-dark mb-1">Đến ngày</label>
                    @Html.TextBoxFor(m => m.ToDate, "{0:yyyy-MM-dd}", new { @class = "form-control form-control-sm", type = "date" })
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-dark mb-1">Danh mục</label>
                    @Html.DropDownListFor(m => m.CategoryId, Model.Categories, "-- Tất cả danh mục --", new { @class = "form-select form-select-sm" })
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-dark mb-1">Mức ưu tiên</label>
                    @Html.DropDownListFor(m => m.PriorityId, Model.Priorities, "-- Tất cả ưu tiên --", new { @class = "form-select form-select-sm" })
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-fill">
                        <i class="fas fa-filter me-1"></i> Lọc
                    </button>
                    <a href="@Url.Action("ExportExcel", "Report", new { fromDate = Model.FromDate.ToString("yyyy-MM-dd"), toDate = Model.ToDate.ToString("yyyy-MM-dd"), categoryId = Model.CategoryId, priorityId = Model.PriorityId })" class="btn btn-outline-success btn-sm flex-fill" title="Tải file Excel">
                        <i class="fas fa-file-excel me-1"></i> Excel
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- 4 Chỉ số KPI thống kê (Phẳng, 1px viền) -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card h-100 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-label">Tổng số phiếu</div>
                        <div class="stat-value">@Model.TotalTickets</div>
                    </div>
                    <div class="stat-icon bg-light text-primary border">
                        <i class="fas fa-layer-group"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card h-100 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-label">Đã giải quyết</div>
                        <div class="stat-value text-success">@Model.ResolvedTickets</div>
                    </div>
                    <div class="stat-icon bg-light text-success border">
                        <i class="fas fa-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card h-100 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-label">Quá hạn SLA</div>
                        <div class="stat-value text-danger">@Model.OverdueTickets</div>
                    </div>
                    <div class="stat-icon bg-light text-danger border">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card h-100 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-label">Tỷ lệ đúng hạn SLA</div>
                        <div class="stat-value text-primary">@Model.SLAComplianceRate<span style="font-size: 16px;">%</span></div>
                    </div>
                    <div class="stat-icon bg-light text-primary border">
                        <i class="fas fa-percent"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Biểu đồ phân tích (4 biểu đồ 2 hàng) -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card h-100 bg-white">
                <div class="card-header bg-white py-3 border-bottom">
                    <span class="fw-semibold text-dark">Phân bố phiếu theo trạng thái</span>
                </div>
                <div class="card-body p-4 d-flex justify-content-center align-items-center">
                    <div style="max-height: 250px; width: 100%;">
                        <canvas id="statusChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 bg-white">
                <div class="card-header bg-white py-3 border-bottom">
                    <span class="fw-semibold text-dark">Số lượng phiếu theo danh mục</span>
                </div>
                <div class="card-body p-4">
                    <div style="max-height: 250px; width: 100%;">
                        <canvas id="categoryChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card h-100 bg-white">
                <div class="card-header bg-white py-3 border-bottom">
                    <span class="fw-semibold text-dark">Phân bố phiếu theo mức ưu tiên</span>
                </div>
                <div class="card-body p-4 d-flex justify-content-center align-items-center">
                    <div style="max-height: 250px; width: 100%;">
                        <canvas id="priorityChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 bg-white">
                <div class="card-header bg-white py-3 border-bottom">
                    <span class="fw-semibold text-dark">Thời gian xử lý trung bình theo danh mục (giờ)</span>
                </div>
                <div class="card-body p-4">
                    <div style="max-height: 250px; width: 100%;">
                        <canvas id="processingTimeChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng hiệu suất nhân viên kỹ thuật -->
    <div class="card mb-4 bg-white">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="fw-semibold text-dark">Hiệu suất nhân viên kỹ thuật</span>
                <span class="text-muted small ms-2">Đo lường KPI và đánh giá chất lượng</span>
            </div>
            <span class="badge bg-light text-dark border">
                Thời gian xử lý TB toàn hệ thống: <strong>@Math.Round(Model.AvgResolutionTimeHours, 1) giờ</strong>
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="staffTable">
                    <thead>
                        <tr>
                            <th style="width: 25%;">Nhân viên kỹ thuật</th>
                            <th style="width: 20%;" class="text-center">Số phiếu xử lý</th>
                            <th style="width: 20%;" class="text-center">Thời gian TB (giờ)</th>
                            <th style="width: 18%;" class="text-center">Đánh giá sao</th>
                            <th style="width: 17%;" class="text-center">Tỷ lệ đúng hạn</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.StaffPerformance != null && Model.StaffPerformance.Any())
                        {
                            foreach (var item in Model.StaffPerformance)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.TechnicianName</div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-success border px-2 py-1 small">
                                            Đã xử lý: @item.TotalResolved
                                        </span>
                                        <span class="text-muted small ms-1">(Tổng giao: @item.TotalAssigned)</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="fw-semibold text-dark">@item.AvgResolutionHours</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="text-warning small">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= Math.Round(item.AvgRating))
                                                {
                                                    <i class="fas fa-star"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star text-muted"></i>
                                                }
                                            }
                                        </div>
                                        <div class="text-muted small" style="font-size: 11px;">@item.AvgRating / 5</div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(item.SLAComplianceRate >= 80 ? "bg-success-subtle text-success border border-success-subtle" : "bg-warning-subtle text-warning border border-warning-subtle") px-2 py-1 small">
                                            @item.SLAComplianceRate%
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted small">
                                    Chưa có dữ liệu hiệu suất trong khoảng thời gian này.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var statusLabels = @Html.Raw(Json.Encode(Model.TicketsByStatus.Keys));
            var statusValues = @Html.Raw(Json.Encode(Model.TicketsByStatus.Values));
            var statusCtx = document.getElementById('statusChart');
            if (statusCtx) {
                new Chart(statusCtx.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: statusLabels,
                        datasets: [{
                            data: statusValues,
                            backgroundColor: ['#3B82F6', '#16A34A', '#DC2626', '#F59E0B', '#8B5CF6', '#98A2B3'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: { 
                        maintainAspectRatio: false, 
                        responsive: true,
                        plugins: {
                            legend: { position: 'bottom', labels: { boxWidth: 12, font: { family: 'Be Vietnam Pro', size: 12 } } }
                        },
                        cutout: '65%'
                    }
                });
            }

            var categoryLabels = @Html.Raw(Json.Encode(Model.TicketsByCategory.Keys));
            var categoryValues = @Html.Raw(Json.Encode(Model.TicketsByCategory.Values));
            var categoryCtx = document.getElementById('categoryChart');
            if (categoryCtx) {
                new Chart(categoryCtx.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: categoryLabels,
                        datasets: [{
                            label: 'Số lượng phiếu',
                            data: categoryValues,
                            backgroundColor: '#1F5FBF',
                            borderRadius: 4
                        }]
                    },
                    options: { 
                        maintainAspectRatio: false, 
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: { 
                            y: { beginAtZero: true, ticks: { stepSize: 1, font: { family: 'Be Vietnam Pro', size: 12 } }, grid: { color: '#EEF2F6' } },
                            x: { ticks: { font: { family: 'Be Vietnam Pro', size: 12 } }, grid: { display: false } }
                        } 
                    }
                });
            }

            var priorityLabels = @Html.Raw(Json.Encode(Model.TicketsByPriority.Keys));
            var priorityValues = @Html.Raw(Json.Encode(Model.TicketsByPriority.Values));
            var priorityCtx = document.getElementById('priorityChart');
            if (priorityCtx) {
                new Chart(priorityCtx.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: priorityLabels,
                        datasets: [{
                            data: priorityValues,
                            backgroundColor: ['#DC2626', '#F59E0B', '#3B82F6', '#16A34A'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: { 
                        maintainAspectRatio: false, 
                        responsive: true,
                        plugins: {
                            legend: { position: 'bottom', labels: { boxWidth: 12, font: { family: 'Be Vietnam Pro', size: 12 } } }
                        },
                        cutout: '65%'
                    }
                });
            }

            var timeLabels = @Html.Raw(Json.Encode(Model.ProcessingTimeByCategory.Keys));
            var timeValues = @Html.Raw(Json.Encode(Model.ProcessingTimeByCategory.Values));
            var timeCtx = document.getElementById('processingTimeChart');
            if (timeCtx) {
                new Chart(timeCtx.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: timeLabels,
                        datasets: [{
                            label: 'Thời gian xử lý (giờ)',
                            data: timeValues,
                            backgroundColor: '#0EA5E9',
                            borderRadius: 4
                        }]
                    },
                    options: { 
                        maintainAspectRatio: false, 
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: { 
                            y: { beginAtZero: true, ticks: { font: { family: 'Be Vietnam Pro', size: 12 } }, grid: { color: '#EEF2F6' } },
                            x: { ticks: { font: { family: 'Be Vietnam Pro', size: 12 } }, grid: { display: false } }
                        } 
                    }
                });
            }
        });
    </script>
}

@model HelpdeskSystem.Models.ViewModels.DashboardViewModel
@using Microsoft.AspNet.Identity
@{
    ViewBag.Title = "Tổng quan hệ thống";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string userName = User.Identity.GetUserName();
}

<div class="container-fluid py-3 px-4">
    <!-- Header tổng quan -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
        <div>
            <h1 class="h4 fw-bold text-dark mb-1">Tổng quan hệ thống</h1>
            <p class="text-muted small mb-0">Xin chào @userName, dưới đây là tình hình tiếp nhận và xử lý yêu cầu kỹ thuật.</p>
        </div>
        <div>
            <a href="@Url.Action("Index", "Ticket")" class="btn btn-primary px-3">
                <i class="fas fa-ticket-alt me-1"></i> Xem danh sách phiếu
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-label">Tổng số phiếu</div>
                        <div class="stat-value">@Model.TotalTickets</div>
                    </div>
                    <div class="stat-icon bg-light text-primary border">
                        <i class="fas fa-layer-group"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                    <a class="small text-decoration-none text-primary" href="@Url.Action("Index", "Ticket")">
                        Xem toàn bộ <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-label">Đang xử lý</div>
                        <div class="stat-value text-warning">@Model.OpenTickets</div>
                    </div>
                    <div class="stat-icon bg-light text-warning border">
                        <i class="fas fa-clock"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                    <a class="small text-decoration-none text-warning" href="@Url.Action("Index", "Ticket", new { QuickFilter = "unassigned" })">
                        Kiểm tra tiến độ <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-label">Đã giải quyết</div>
                        <div class="stat-value text-success">@Model.ResolvedToday</div>
                    </div>
                    <div class="stat-icon bg-light text-success border">
                        <i class="fas fa-check-circle"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                    <a class="small text-decoration-none text-success" href="@Url.Action("Index", "Ticket")">
                        Xem phiếu hoàn thành <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-label">Quá hạn SLA</div>
                        <div class="stat-value text-danger">@Model.OverdueTickets</div>
                    </div>
                    <div class="stat-icon bg-light text-danger border">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                    <a class="small text-decoration-none text-danger" href="@Url.Action("Index", "Ticket", new { QuickFilter = "overdue" })">
                        Cần can thiệp <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 2 Biểu đồ Chart.js -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <div class="fw-semibold text-dark">Tỷ lệ phiếu theo trạng thái</div>
                    <span class="badge bg-light text-secondary border">Biểu đồ tròn</span>
                </div>
                <div class="card-body p-4 d-flex justify-content-center align-items-center">
                    <div style="max-height: 260px; width: 100%;">
                        <canvas id="statusChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <div class="fw-semibold text-dark">Số lượng phiếu theo danh mục sự cố</div>
                    <span class="badge bg-light text-secondary border">Biểu đồ cột</span>
                </div>
                <div class="card-body p-4">
                    <div style="max-height: 260px; width: 100%;">
                        <canvas id="categoryChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách phiếu gần đây -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="fw-semibold text-dark">Các phiếu yêu cầu mới nhất</span>
                <span class="text-muted small ms-2">(@(Model.RecentTickets != null ? Model.RecentTickets.Count : 0) phiếu)</span>
            </div>
            <a href="@Url.Action("Index", "Ticket")" class="btn btn-sm btn-outline-secondary">
                Xem toàn bộ phiếu <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 15%;">Mã phiếu</th>
                            <th style="width: 32%;">Tiêu đề sự cố &amp; Danh mục</th>
                            <th style="width: 14%;" class="text-center">Ưu tiên</th>
                            <th style="width: 14%;" class="text-center">Trạng thái</th>
                            <th style="width: 15%;">Kỹ thuật viên</th>
                            <th style="width: 10%;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentTickets != null && Model.RecentTickets.Any())
                        {
                            foreach (var item in Model.RecentTickets)
                            {
                                string priorityColor = !string.IsNullOrEmpty(item.PriorityColor) ? item.PriorityColor : "#64748b";

                                <tr>
                                    <td>
                                        <a href="@Url.Action("Details", "Ticket", new { id = item.TicketId })" class="fw-bold text-primary font-monospace text-decoration-none">
                                            @item.TicketCode
                                        </a>
                                        <div class="text-muted small" style="font-size: 11px;">@item.CreatedDate</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.Title</div>
                                        <span class="badge bg-light text-muted border py-0 px-2 small" style="font-size: 11px;">
                                            @item.CategoryName
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge px-2 py-1 small" style="background-color: @priorityColor; color: white;">
                                            @item.Priority
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-secondary border px-2 py-1 small">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td>
                                        @if (string.IsNullOrEmpty(item.AssignedTo) || item.AssignedTo == "Chưa phân công")
                                        {
                                            <span class="text-muted small">Chưa phân công</span>
                                        }
                                        else
                                        {
                                            <span class="text-dark small fw-medium">@item.AssignedTo</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a href="@Url.Action("Details", "Ticket", new { id = item.TicketId })" class="btn btn-sm btn-outline-primary px-2 py-1 small">
                                            Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted small">
                                    Hiện chưa có phiếu yêu cầu nào trong hệ thống.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            var statusLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.TicketsByStatus.Keys));
            var statusData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.TicketsByStatus.Values));
            
            var statusColors = [
                '#3B82F6', // Mới
                '#F59E0B', // Đang xử lý
                '#8B5CF6', // Chờ
                '#16A34A', // Đã giải quyết
                '#98A2B3', // Đã đóng
                '#DC2626'  // Mở lại
            ];

            var ctxStatus = document.getElementById("statusChart");
            if (ctxStatus) {
                new Chart(ctxStatus, {
                    type: 'doughnut',
                    data: {
                        labels: statusLabels,
                        datasets: [{
                            data: statusData,
                            backgroundColor: statusColors,
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }],
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    boxWidth: 12,
                                    padding: 12,
                                    font: { family: 'Be Vietnam Pro', size: 12 }
                                }
                            }
                        },
                        cutout: '70%'
                    }
                });
            }

            var categoryLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.TicketsByCategory.Keys));
            var categoryData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.TicketsByCategory.Values));

            var ctxCategory = document.getElementById("categoryChart");
            if (ctxCategory) {
                new Chart(ctxCategory, {
                    type: 'bar',
                    data: {
                        labels: categoryLabels,
                        datasets: [{
                            label: "Số phiếu",
                            backgroundColor: "#1F5FBF",
                            borderRadius: 4,
                            data: categoryData,
                        }],
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { stepSize: 1, font: { family: 'Be Vietnam Pro', size: 12 } },
                                grid: { color: '#EEF2F6' }
                            },
                            x: {
                                ticks: { font: { family: 'Be Vietnam Pro', size: 12 } },
                                grid: { display: false }
                            }
                        },
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }
        });
    </script>
}

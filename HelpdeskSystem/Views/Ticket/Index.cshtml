@model HelpdeskSystem.Models.ViewModels.TicketListVM

@{
    ViewBag.Title = "Danh sách Phiếu Yêu cầu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isUser = !User.IsInRole("Admin") && !User.IsInRole("Technician");
}

@section Styles {
    <style>
        /* 1. Header always on 1 single line and centered */
        #ticketsTable thead th {
            text-align: center !important;
            white-space: nowrap !important;
            font-size: 0.82rem !important;
            font-weight: 700 !important;
            color: #475569 !important;
            background-color: #f8fafc !important;
            border-bottom: 2px solid #e2e8f0 !important;
            padding: 12px 14px !important;
            cursor: pointer !important;
            user-select: none !important;
        }

        /* 2. Content below can span as many lines as needed */
        #ticketsTable tbody td {
            white-space: normal !important;
            word-break: break-word !important;
            vertical-align: middle !important;
            padding: 12px 14px !important;
        }

        /* 3. Completely wipe out sort arrows while keeping column click-to-sort */
        #ticketsTable.dataTable thead > tr > th:before,
        #ticketsTable.dataTable thead > tr > th:after,
        #ticketsTable.dataTable thead > tr > td:before,
        #ticketsTable.dataTable thead > tr > td:after,
        table.dataTable thead > tr > th.sorting:before,
        table.dataTable thead > tr > th.sorting:after,
        table.dataTable thead > tr > th.sorting_asc:before,
        table.dataTable thead > tr > th.sorting_asc:after,
        table.dataTable thead > tr > th.sorting_desc:before,
        table.dataTable thead > tr > th.sorting_desc:after,
        table.dataTable thead > tr > th.sorting_asc_disabled:before,
        table.dataTable thead > tr > th.sorting_asc_disabled:after,
        table.dataTable thead > tr > th.sorting_desc_disabled:before,
        table.dataTable thead > tr > th.sorting_desc_disabled:after {
            display: none !important;
            content: none !important;
            opacity: 0 !important;
            visibility: hidden !important;
            width: 0 !important;
            height: 0 !important;
        }

        /* 4. Reset right padding that was reserved for sort arrows */
        #ticketsTable thead > tr > th,
        #ticketsTable thead > tr > td {
            padding-right: 14px !important;
        }

        /* 5. Hide DataTable Info label */
        div.dataTables_wrapper div.dataTables_info {
            display: none !important;
        }

        /* 6. Clean square pagination */
        div.dataTables_wrapper div.dataTables_paginate {
            padding-top: 14px !important;
        }
        div.dataTables_wrapper div.dataTables_paginate ul.pagination {
            gap: 4px !important;
            margin: 0 !important;
        }
        div.dataTables_wrapper div.dataTables_paginate ul.pagination .page-item .page-link {
            width: 28px !important;
            min-width: 28px !important;
            height: 28px !important;
            padding: 0 !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            font-size: 0.8rem !important;
            font-weight: 600 !important;
            border-radius: 4px !important;
            line-height: 1 !important;
        }

        /* 7. Hover effect on rows */
        #ticketsTable tbody tr.ticket-row:hover {
            background-color: #f8faff !important;
        }
    </style>
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-3">
            <div class="col-sm-6">
                <h1 class="m-0 d-flex align-items-center gap-2">
                    <span class="badge bg-primary-soft text-primary p-2 rounded-3"><i class="fas fa-ticket-alt"></i></span>
                    <span class="fw-bold fs-4 text-dark">Danh sách Phiếu Yêu cầu</span>
                </h1>
                <p class="text-muted small mt-1 mb-0">
                    @if (isUser)
                    {
                        <span>Quản lý và theo dõi tiến độ các sự cố bạn đã gửi tới bộ phận kỹ thuật.</span>
                    }
                    else if (User.IsInRole("Technician"))
                    {
                        <span>Danh sách các phiếu sự cố được phân công cho bạn hoặc thuộc phòng ban của bạn.</span>
                    }
                    else
                    {
                        <span>Toàn bộ các phiếu yêu cầu trên toàn hệ thống cần theo dõi và điều phối.</span>
                    }
                </p>
            </div>
            <div class="col-sm-6 text-end">
                @if (isUser)
                {
                    <a href="@Url.Action("Create", "Ticket")" class="btn btn-primary px-3 py-2 shadow-sm">
                        <i class="fas fa-plus me-1"></i> Gửi yêu cầu mới
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Filter Panel -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center" data-bs-toggle="collapse" data-bs-target="#filterPanel" style="cursor: pointer;">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary-soft text-primary p-2 rounded-circle"><i class="fas fa-filter"></i></span>
                    <h6 class="m-0 fw-bold text-dark">Bộ lọc tìm kiếm</h6>
                </div>
                <i class="fas fa-chevron-down text-muted"></i>
            </div>
            <div id="filterPanel" class="collapse show">
                <div class="card-body p-4 bg-light bg-opacity-50">
                    @using (Html.BeginForm("Index", "Ticket", FormMethod.Get))
                    {
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label"><i class="fas fa-circle-dot text-primary me-1 small"></i>Trạng thái xử lý</label>
                                @Html.DropDownListFor(m => m.Filter.Status, Model.Filter.Statuses ?? new List<SelectListItem>(), "-- Tất cả trạng thái --", new { @class = "form-select" })
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><i class="fas fa-folder text-warning me-1 small"></i>Danh mục sự cố</label>
                                @Html.DropDownListFor(m => m.Filter.CategoryId, Model.Filter.Categories ?? new List<SelectListItem>(), "-- Tất cả danh mục --", new { @class = "form-select" })
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><i class="fas fa-flag text-danger me-1 small"></i>Mức độ ưu tiên</label>
                                @Html.DropDownListFor(m => m.Filter.PriorityId, Model.Filter.Priorities ?? new List<SelectListItem>(), "-- Tất cả mức ưu tiên --", new { @class = "form-select" })
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label"><i class="far fa-calendar-alt text-muted me-1 small"></i>Từ ngày</label>
                                @Html.TextBoxFor(m => m.Filter.FromDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><i class="far fa-calendar-alt text-muted me-1 small"></i>Đến ngày</label>
                                @Html.TextBoxFor(m => m.Filter.ToDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><i class="fas fa-search text-muted me-1 small"></i>Từ khóa tìm kiếm</label>
                                @Html.TextBoxFor(m => m.Filter.SearchTerm, new { @class = "form-control", placeholder = "Mã phiếu, tiêu đề..." })
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <a href="@Url.Action("Index", "Ticket")" class="btn btn-outline-secondary">
                                <i class="fas fa-undo me-1"></i> Đặt lại
                            </a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="fas fa-search me-1"></i> Lọc dữ liệu
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Data Table Card (Clean Streamlined View) -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary-soft text-primary p-2 rounded-circle"><i class="fas fa-list"></i></span>
                    <h6 class="m-0 fw-bold text-dark">Danh sách phiếu (@(Model.Tickets != null ? Model.Tickets.Count : 0))</h6>
                </div>
                <div class="text-muted small">
                    <i class="far fa-lightbulb text-warning me-1"></i>
                    <span>Nhấp vào hàng bất kỳ để xem nhanh chi tiết</span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive p-3">
                    <table id="ticketsTable" class="table table-hover align-middle w-100 mb-0">
                        <thead>
                            <tr>
                                <th class="text-center text-nowrap" style="width: 22%;">PHIẾU YÊU CẦU</th>
                                <th class="text-center text-nowrap" style="width: 17%;">TRẠNG THÁI &amp; ƯU TIÊN</th>
                                <th class="text-center text-nowrap" style="width: 27%;">KỸ THUẬT VIÊN</th>
                                <th class="text-center text-nowrap" style="width: 20%;">THỜI GIAN &amp; SLA</th>
                                <th class="text-center text-nowrap" style="width: 14%;">THAO TÁC</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Tickets != null)
                            {
                                foreach (var item in Model.Tickets)
                                {
                                    string sBg = "bg-secondary text-white";
                                    if (item.StatusColor == "info") { sBg = "bg-info text-dark"; }
                                    else if (item.StatusColor == "primary") { sBg = "bg-primary text-white"; }
                                    else if (item.StatusColor == "warning") { sBg = "bg-warning text-dark"; }
                                    else if (item.StatusColor == "success") { sBg = "bg-success text-white"; }
                                    else if (item.StatusColor == "danger") { sBg = "bg-danger text-white"; }
                                    else if (item.StatusColor == "dark") { sBg = "bg-dark text-white"; }

                                    string priorityHex = !string.IsNullOrEmpty(item.PriorityColor) ? item.PriorityColor : "#64748b";

                                    <tr class="ticket-row" 
                                        style="cursor: pointer;"
                                        data-id="@item.TicketId"
                                        data-code="@item.TicketCode"
                                        data-title="@item.Title"
                                        data-description="@(item.Description ?? "Không có mô tả chi tiết.")"
                                        data-category="@item.CategoryName"
                                        data-priority="@item.PriorityName"
                                        data-priority-color="@priorityHex"
                                        data-status="@item.StatusDisplay"
                                        data-status-bg="@sBg"
                                        data-creator="@item.CreatedByName"
                                        data-assignee="@(string.IsNullOrEmpty(item.AssignedToName) ? "Chưa nhận" : item.AssignedToName)"
                                        data-date="@item.CreatedDate"
                                        data-sla="@item.SLAStatus"
                                        data-sla-color="@item.SLAStatusColor"
                                        data-url="@Url.Action("Details", "Ticket", new { id = item.TicketId })">
                                        
                                        <!-- Cột 1: Phiếu yêu cầu (Mỗi mục 1 dòng: Mã 1 dòng, Danh mục 1 dòng, Tiêu đề nhiều dòng) -->
                                        <td class="text-center px-2">
                                            <!-- Dòng 1: Mã phiếu -->
                                            <div class="mb-1">
                                                <span class="fw-bold text-primary font-monospace" style="font-size: 0.88rem;">@item.TicketCode</span>
                                            </div>

                                            <!-- Dòng 2: Danh mục (riêng 1 dòng, có thể xuống dòng nếu tên dài) -->
                                            <div class="mb-1">
                                                <span class="badge bg-light text-muted border py-1 px-2" style="font-size: 0.74rem; white-space: normal; line-height: 1.3;">
                                                    <i class="fas fa-folder me-1 text-warning small"></i>@item.CategoryName
                                                </span>
                                            </div>

                                            <!-- Dòng 3+: Tiêu đề sự cố / Phần còn lại (tự do nhiều dòng) -->
                                            <div class="fw-semibold text-dark" style="font-size: 0.88rem; line-height: 1.4; word-break: break-word;">
                                                @item.Title
                                            </div>
                                        </td>

                                        <!-- Cột 2: Trạng thái & Ưu tiên (Mỗi mục 1 dòng) -->
                                        <td class="text-center">
                                            <!-- Dòng 1: Trạng thái -->
                                            <div class="mb-1">
                                                <span class="badge @sBg px-2 py-1" style="font-size: 0.78rem;">@item.StatusDisplay</span>
                                            </div>
                                            <!-- Dòng 2: Mức độ ưu tiên -->
                                            <div>
                                                <span class="badge px-2 py-1" style="background-color: @priorityHex; color: white; font-size: 0.78rem;">
                                                    @item.PriorityName
                                                </span>
                                            </div>
                                        </td>

                                        <!-- Cột 3: Kỹ thuật viên phụ trách & Người tạo (căn giữa) -->
                                        <td class="text-center">
                                            @if (string.IsNullOrEmpty(item.AssignedToName))
                                            {
                                                <span class="badge bg-light text-muted border px-2 py-1">
                                                    <i class="fas fa-user-clock me-1 text-secondary"></i>Chưa phân công
                                                </span>
                                            }
                                            else
                                            {
                                                <div class="fw-semibold text-dark">
                                                    <i class="fas fa-user-gear text-primary me-1"></i>@item.AssignedToName
                                                </div>
                                            }
                                            <div class="text-muted mt-1" style="font-size: 0.76rem;">
                                                <span class="text-secondary">Người tạo:</span> @item.CreatedByName
                                            </div>
                                        </td>

                                        <!-- Cột 4: Thời gian & SLA (căn giữa) -->
                                        <td class="text-center">
                                            <div class="small text-muted mb-1">
                                                <i class="far fa-calendar-alt me-1"></i>@item.CreatedDate
                                            </div>
                                            <div>
                                                @if (!string.IsNullOrEmpty(item.SLAStatus) && item.SLAStatus != "N/A")
                                                {
                                                    if (item.SLAStatusColor == "danger")
                                                    {
                                                        <span class="badge bg-danger text-white">Quá hạn</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success text-white">Đúng hạn</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">-</span>
                                                }
                                            </div>
                                        </td>

                                        <!-- Cột 5: Thao tác (chỉ giữ nút Chi tiết, không trùng lặp nút Xem) -->
                                        <td class="text-center">
                                            <a href="@Url.Action("Details", "Ticket", new { id = item.TicketId })" 
                                               class="btn btn-sm btn-outline-primary px-3 py-1 text-nowrap rounded-2 shadow-none" 
                                               title="Mở trang chi tiết &amp; xử lý" 
                                               onclick="event.stopPropagation();">
                                                <i class="fas fa-arrow-up-right-from-square me-1 small"></i>Chi tiết
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Quick View Detail Modal (Harmonious & Professional Layout) -->
<div class="modal fade" id="ticketQuickModal" tabindex="-1" aria-labelledby="ticketQuickModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden">
            <!-- Modal Header -->
            <div class="modal-header bg-light py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge bg-primary fs-6 px-3 py-1 font-monospace" id="modalTicketCode"></span>
                    <span class="badge" id="modalStatusBadge"></span>
                    <span class="badge" id="modalPriorityBadge"></span>
                    <span class="badge" id="modalSLABadge"></span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-4">
                <!-- Title -->
                <div class="mb-4">
                    <h5 class="fw-bold text-dark mb-1" id="modalTicketTitle" style="line-height: 1.4;"></h5>
                </div>

                <!-- 2-Column Split: Description (Left) + Details Grid (Right) -->
                <div class="row g-4">
                    <!-- Left: Problem Description -->
                    <div class="col-md-7">
                        <div class="d-flex align-items-center gap-2 mb-2 text-primary fw-bold small text-uppercase" style="letter-spacing: 0.04em;">
                            <i class="fas fa-align-left"></i>
                            <span>Nội dung mô tả sự cố</span>
                        </div>
                        <div class="p-3 bg-light rounded-3 text-dark border" style="border-left: 3px solid #2563eb !important; min-height: 190px; max-height: 260px; overflow-y: auto;">
                            <div id="modalTicketDesc" style="white-space: pre-wrap; line-height: 1.6; font-size: 0.93rem;"></div>
                        </div>
                    </div>

                    <!-- Right: Metadata Cards -->
                    <div class="col-md-5">
                        <div class="d-flex align-items-center gap-2 mb-2 text-muted fw-bold small text-uppercase" style="letter-spacing: 0.04em;">
                            <i class="fas fa-info-circle text-primary"></i>
                            <span>Thông số kỹ thuật</span>
                        </div>
                        <div class="d-flex flex-column gap-2">
                            <div class="p-2 px-3 bg-light rounded border">
                                <small class="text-muted d-block" style="font-size: 0.72rem; letter-spacing: 0.03em;">DANH MỤC</small>
                                <strong class="text-dark small" id="modalCategory"></strong>
                            </div>
                            <div class="p-2 px-3 bg-light rounded border">
                                <small class="text-muted d-block" style="font-size: 0.72rem; letter-spacing: 0.03em;">NGƯỜI GỬI YÊU CẦU</small>
                                <strong class="text-dark small" id="modalCreator"></strong>
                            </div>
                            <div class="p-2 px-3 bg-light rounded border">
                                <small class="text-muted d-block" style="font-size: 0.72rem; letter-spacing: 0.03em;">KỸ THUẬT VIÊN PHỤ TRÁCH</small>
                                <strong class="small" id="modalAssignee"></strong>
                            </div>
                            <div class="p-2 px-3 bg-light rounded border">
                                <small class="text-muted d-block" style="font-size: 0.72rem; letter-spacing: 0.03em;">THỜI GIAN GỬI</small>
                                <strong class="text-dark small" id="modalDate"></strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer bg-light border-top py-2 px-4 d-flex justify-content-between align-items-center">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Đóng</button>
                <div class="d-flex gap-2">
                    <a href="#" id="modalChatBtn" class="btn btn-outline-primary btn-sm px-3 fw-semibold shadow-none">
                        <i class="fas fa-comments me-1"></i>Nhắn tin trao đổi
                    </a>
                    <a href="#" id="modalDetailBtn" class="btn btn-primary btn-sm px-3 fw-semibold shadow-sm">
                        Xem chi tiết &amp; Xử lý <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // DataTables configured with small square pagination & no info text
            $('#ticketsTable').DataTable({
                "autoWidth": false,
                "columnDefs": [
                    { "width": "22%", "targets": 0 },
                    { "width": "17%", "targets": 1 },
                    { "width": "27%", "targets": 2 },
                    { "width": "20%", "targets": 3 },
                    { "width": "14%", "targets": 4, "orderable": false }
                ],
                "lengthChange": false,
                "searching": false,
                "info": false,        // REMOVE "Hiển thị 1 - 2 trong tổng số 2 phiếu"
                "order": [[3, "desc"]], // sort by date/sla column
                "responsive": false,
                "pageLength": 10,
                "language": {
                    "emptyTable": "Không có phiếu yêu cầu nào phù hợp điều kiện lọc",
                    "paginate": {
                        "first": "«",
                        "last": "»",
                        "next": ">",
                        "previous": "<"
                    }
                }
            });

            // Interactive Quick View Modal click handler
            $('#ticketsTable tbody').on('click', 'tr.ticket-row', function (e) {
                // If user clicked the direct link button, let it navigate
                if ($(e.target).closest('a').length) return;

                var row = $(this);
                var code = row.data('code');
                var title = row.data('title');
                var desc = row.data('description');
                var category = row.data('category');
                var priority = row.data('priority');
                var priorityColor = row.data('priority-color');
                var status = row.data('status');
                var statusBg = row.data('status-bg');
                var creator = row.data('creator');
                var assignee = row.data('assignee');
                var date = row.data('date');
                var sla = row.data('sla');
                var slaColor = row.data('sla-color');
                var id = row.data('id');
                var url = row.data('url');

                $('#modalTicketCode').text(code);
                $('#modalTicketTitle').text(title);
                $('#modalTicketDesc').text(desc);
                $('#modalCategory').text(category || 'Chung');
                $('#modalCreator').text(creator);
                $('#modalAssignee').text(assignee);
                if (assignee === 'Chưa nhận') {
                    $('#modalAssignee').attr('class', 'small text-muted');
                } else {
                    $('#modalAssignee').attr('class', 'small text-success fw-bold');
                }
                $('#modalDate').text(date);

                // Status badge
                $('#modalStatusBadge').attr('class', 'badge ' + statusBg).text(status);

                // Priority badge
                $('#modalPriorityBadge')
                    .attr('class', 'badge')
                    .css('background-color', priorityColor)
                    .css('color', '#ffffff')
                    .text(priority);

                // SLA badge
                if (sla && sla !== 'N/A') {
                    var slaBadgeClass = slaColor === 'danger' ? 'badge bg-danger text-white' : 'badge bg-success text-white';
                    $('#modalSLABadge').attr('class', slaBadgeClass).text(sla).show();
                } else {
                    $('#modalSLABadge').hide();
                }

                $('#modalDetailBtn').attr('href', url);
                $('#modalChatBtn').attr('href', '@Url.Action("Chat", "Ticket")/' + id);
                $('#ticketQuickModal').modal('show');
            });
        });
    </script>
}

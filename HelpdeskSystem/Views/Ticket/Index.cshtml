@model HelpdeskSystem.Models.ViewModels.TicketListVM

@{
    ViewBag.Title = "Danh sách phiếu yêu cầu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isUser = !User.IsInRole("Admin") && !User.IsInRole("Manager") && !User.IsInRole("Technician");
    string qf = Model.Filter != null ? (Model.Filter.QuickFilter ?? "") : "";
}

<div class="container-fluid py-3 px-4">
    
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h1 class="h4 fw-bold text-dark mb-1">Danh sách phiếu yêu cầu</h1>
            <p class="text-muted small mb-0">
                @if (isUser)
                {
                    <span>Theo dõi tiến độ các yêu cầu hỗ trợ bạn đã gửi đến bộ phận IT.</span>
                }
                else if (User.IsInRole("Technician"))
                {
                    <span>Các phiếu yêu cầu được phân công cho bạn hoặc thuộc chuyên môn phụ trách.</span>
                }
                else
                {
                    <span>Toàn bộ các phiếu yêu cầu trên toàn hệ thống cần theo dõi và điều phối.</span>
                }
            </p>
        </div>
        <div>
            @if (isUser)
            {
                <a href="@Url.Action("Create", "Ticket")" class="btn btn-primary px-3">
                    <i class="fas fa-plus me-1"></i> Gửi yêu cầu mới
                </a>
            }
        </div>
    </div>

    <!-- Thanh lọc nhanh theo nhóm (dành cho KTV / Quản lý / Admin) -->
    @if (!isUser)
    {
        <div class="d-flex flex-wrap gap-2 mb-3">
            <a href="@Url.Action("Index", "Ticket")" class="btn btn-sm @(string.IsNullOrEmpty(qf) ? "btn-primary" : "btn-outline-secondary bg-white")">
                Tất cả phiếu
            </a>
            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <a href="@Url.Action("Index", "Ticket", new { QuickFilter = "unassigned" })" class="btn btn-sm @(qf == "unassigned" ? "btn-primary" : "btn-outline-secondary bg-white")">
                    Chưa phân công
                </a>
            }
            <a href="@Url.Action("Index", "Ticket", new { QuickFilter = "duesoon" })" class="btn btn-sm @(qf == "duesoon" ? "btn-primary" : "btn-outline-secondary bg-white")">
                Sắp đến hạn
            </a>
            <a href="@Url.Action("Index", "Ticket", new { QuickFilter = "overdue" })" class="btn btn-sm @(qf == "overdue" ? "btn-danger" : "btn-outline-danger bg-white")">
                Quá hạn SLA
            </a>
        </div>
    }

    <!-- Khung bộ lọc tìm kiếm (Mặc định ẩn, bấm vào để mở rộng) -->
    <div class="card mb-4 border" style="border-color: #D9DEE5; border-radius: 6px;">
        <div class="card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center" data-bs-toggle="collapse" data-bs-target="#filterPanel" style="cursor: pointer; border-color: #D9DEE5 !important;">
            <div class="d-flex align-items-center gap-2">
                <i class="fas fa-filter text-primary small"></i>
                <span class="fw-semibold text-dark small">Bộ lọc tìm kiếm</span>
            </div>
            <i class="fas fa-chevron-down text-muted small filter-chevron"></i>
        </div>
        <div id="filterPanel" class="collapse">
            <div class="card-body p-3 bg-light">
                @using (Html.BeginForm("Index", "Ticket", FormMethod.Get))
                {
                    <div class="row g-2 mb-2">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-dark mb-1">Trạng thái xử lý</label>
                            @Html.DropDownListFor(m => m.Filter.Status, Model.Filter.Statuses ?? new List<SelectListItem>(), "-- Tất cả trạng thái --", new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-dark mb-1">Danh mục sự cố</label>
                            @Html.DropDownListFor(m => m.Filter.CategoryId, Model.Filter.Categories ?? new List<SelectListItem>(), "-- Tất cả danh mục --", new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-dark mb-1">Mức độ ưu tiên</label>
                            @Html.DropDownListFor(m => m.Filter.PriorityId, Model.Filter.Priorities ?? new List<SelectListItem>(), "-- Tất cả mức ưu tiên --", new { @class = "form-select form-select-sm" })
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-dark mb-1">Từ ngày</label>
                            @Html.TextBoxFor(m => m.Filter.FromDate, "{0:yyyy-MM-dd}", new { @class = "form-control form-control-sm", type = "date" })
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-dark mb-1">Đến ngày</label>
                            @Html.TextBoxFor(m => m.Filter.ToDate, "{0:yyyy-MM-dd}", new { @class = "form-control form-control-sm", type = "date" })
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-dark mb-1">Từ khóa tìm kiếm</label>
                            @Html.TextBoxFor(m => m.Filter.SearchTerm, new { @class = "form-control form-control-sm", placeholder = "Mã phiếu, tiêu đề sự cố..." })
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a href="@Url.Action("Index", "Ticket")" class="btn btn-sm btn-outline-secondary px-3">
                            Đặt lại
                        </a>
                        <button type="submit" class="btn btn-sm btn-primary px-3">
                            <i class="fas fa-search me-1"></i> Lọc dữ liệu
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Bảng danh sách phiếu (Chuẩn Jira / Freshdesk) -->
    <div class="card mb-4 border" style="border-color: #D9DEE5; border-radius: 6px;">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center" style="border-color: #D9DEE5 !important;">
            <div>
                <span class="fw-semibold text-dark">Danh sách phiếu yêu cầu</span>
                <span class="badge bg-light text-secondary border ms-2">@(Model.Tickets != null ? Model.Tickets.Count : 0)</span>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="ticketsTable" class="table table-hover align-middle w-100 mb-0">
                    <thead>
                        <tr>
                            <th style="width: 14%;">Mã phiếu</th>
                            <th style="width: 32%;">Tiêu đề &amp; Danh mục</th>
                            <th style="width: 12%;" class="text-center">Mức ưu tiên</th>
                            <th style="width: 13%;" class="text-center">Trạng thái</th>
                            <th style="width: 15%;">Người phụ trách</th>
                            <th style="width: 14%;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Tickets != null && Model.Tickets.Any())
                        {
                            foreach (var item in Model.Tickets)
                            {
                                string priorityColor = !string.IsNullOrEmpty(item.PriorityColor) ? item.PriorityColor : "#64748b";

                                <tr>
                                    <td>
                                        <a href="@Url.Action("Details", "Ticket", new { id = item.TicketId })" class="fw-bold text-primary font-monospace text-decoration-none">
                                            @item.TicketCode
                                        </a>
                                        <div class="text-muted small" style="font-size: 11px;">@item.CreatedDate</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.Title</div>
                                        <span class="badge bg-light text-muted border py-0 px-2 small" style="font-size: 11px;">
                                            @item.CategoryName
                                        </span>
                                        <span class="text-muted small ms-1" style="font-size: 11px;">&bull; Gửi bởi @item.CreatedByName</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge px-2 py-1 small" style="background-color: @priorityColor; color: white;">
                                            @item.PriorityName
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-secondary border px-2 py-1 small">
                                            @item.StatusDisplay
                                        </span>
                                    </td>
                                    <td>
                                        @if (string.IsNullOrEmpty(item.AssignedToName) || item.AssignedToName == "Chưa phân công")
                                        {
                                            <span class="text-muted small">Chưa phân công</span>
                                        }
                                        else
                                        {
                                            <span class="text-dark small fw-medium">@item.AssignedToName</span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.SLAStatus) && item.SLAStatus != "N/A")
                                        {
                                            <div class="mt-1">
                                                @if (item.SLAStatusColor == "danger")
                                                {
                                                    <span class="badge bg-danger text-white py-0 px-1 small" style="font-size: 10px;">Quá hạn SLA</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success text-white py-0 px-1 small" style="font-size: 10px;">Đúng hạn</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a href="@Url.Action("Details", "Ticket", new { id = item.TicketId })" class="btn btn-sm btn-outline-primary px-3 py-1 small">
                                            Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <div class="py-2">
                                        <i class="fas fa-inbox fa-2x mb-2 d-block text-secondary opacity-50"></i>
                                        <span>Không có phiếu yêu cầu nào phù hợp điều kiện lọc.</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Hiệu ứng mũi tên khi đóng / mở Bộ lọc tìm kiếm
            $('#filterPanel').on('show.bs.collapse', function () {
                $('.filter-chevron').removeClass('fa-chevron-down').addClass('fa-chevron-up');
            }).on('hide.bs.collapse', function () {
                $('.filter-chevron').removeClass('fa-chevron-up').addClass('fa-chevron-down');
            });

            if ($.fn.dataTable) {
                // Tắt hoàn toàn chế độ popup alert của DataTables
                $.fn.dataTable.ext.errMode = 'none';

                // Chỉ khởi tạo phân trang DataTables khi bảng có nhiều hơn 10 dòng và không phải bảng rỗng
                var rowCount = $('#ticketsTable tbody tr').length;
                var hasEmptyRow = $('#ticketsTable tbody tr td[colspan]').length > 0;

                if (rowCount > 10 && !hasEmptyRow) {
                    $('#ticketsTable').DataTable({
                        autoWidth: false,
                        lengthChange: false,
                        searching: false,
                        info: false,
                        ordering: false,
                        pageLength: 10,
                        language: {
                            paginate: {
                                first: "«",
                                last: "»",
                                next: ">",
                                previous: "<"
                            }
                        }
                    });
                }
            }
        });
    </script>
}

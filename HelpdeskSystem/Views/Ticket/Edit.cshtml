@model HelpdeskSystem.Models.ViewModels.TicketEditVM

@{
    ViewBag.Title = "Chỉnh sửa phiếu - " + Model.TicketCode;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Chỉnh sửa phiếu @Model.TicketCode</h1>
            </div>
            <div class="col-sm-6 text-end">
                <a href="@Url.Action("Details", "Ticket", new { id = Model.TicketId })" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Trở lại
                </a>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="card card-warning">
                    <div class="card-header">
                        <h3 class="card-title">Cập nhật thông tin phiếu</h3>
                    </div>
                    
                    @using (Html.BeginForm("Edit", "Ticket", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.TicketId)
                        @Html.HiddenFor(m => m.TicketCode)
                        
                        <div class="card-body">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger alert alert-danger" })

                            <div class="mb-3">
                                <label class="form-label">Tiêu đề <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Mô tả <span class="text-danger">*</span></label>
                                @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "5" })
                                @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Danh mục <span class="text-danger">*</span></label>
                                    @Html.DropDownListFor(m => m.CategoryId, Model.Categories ?? new List<SelectListItem>(), "-- Chọn danh mục --", new { @class = "form-select" })
                                    @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Mức ưu tiên <span class="text-danger">*</span></label>
                                    @Html.DropDownListFor(m => m.PriorityId, Model.Priorities ?? new List<SelectListItem>(), "-- Chọn mức ưu tiên --", new { @class = "form-select" })
                                    @Html.ValidationMessageFor(m => m.PriorityId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="card-footer">
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save"></i> Lưu thay đổi
                            </button>
                            <a href="@Url.Action("Details", "Ticket", new { id = Model.TicketId })" class="btn btn-default float-right">Hủy</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

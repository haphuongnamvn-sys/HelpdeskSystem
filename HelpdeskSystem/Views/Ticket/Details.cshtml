@model HelpdeskSystem.Models.ViewModels.TicketDetailVM
@using HelpdeskSystem.Models
@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = "Chi tiết phiếu #" + Model.TicketCode;
    Layout = "~/Views/Shared/_Layout.cshtml";
    int commentCount = Model.Comments != null ? Model.Comments.Count : 0;
    string currentUserId = User.Identity.GetUserId();
    string currentUserName = User.Identity.Name;
    bool isStaff = User.IsInRole("Admin") || User.IsInRole("Technician");

    // Màu sắc và viền cho Trạng thái
    string statusBg = "#eff6ff";
    string statusText = "#1d4ed8";
    string statusBorder = "#bfdbfe";
    switch (Model.Status)
    {
        case TicketStatus.New:
            statusBg = "#f0f9ff"; statusText = "#0369a1"; statusBorder = "#bae6fd"; break;
        case TicketStatus.Assigned:
            statusBg = "#e0e7ff"; statusText = "#4338ca"; statusBorder = "#c7d2fe"; break;
        case TicketStatus.InProgress:
            statusBg = "#fef3c7"; statusText = "#b45309"; statusBorder = "#fde68a"; break;
        case TicketStatus.Pending:
            statusBg = "#f1f5f9"; statusText = "#475569"; statusBorder = "#cbd5e1"; break;
        case TicketStatus.Resolved:
            statusBg = "#dcfce7"; statusText = "#15803d"; statusBorder = "#86efac"; break;
        case TicketStatus.Closed:
            statusBg = "#f3f4f6"; statusText = "#374151"; statusBorder = "#d1d5db"; break;
        case TicketStatus.Reopened:
            statusBg = "#ffe4e6"; statusText = "#be123c"; statusBorder = "#fecdd3"; break;
    }

    // Màu sắc và chấm biểu thị cho Mức độ ưu tiên
    string prioBg = "#f1f5f9";
    string prioText = "#334155";
    string prioBorder = "#e2e8f0";
    string prioDot = "#94a3b8";
    if (Model.PriorityName == "Critical") { prioBg = "#fee2e2"; prioText = "#b91c1c"; prioBorder = "#fca5a5"; prioDot = "#dc2626"; }
    else if (Model.PriorityName == "High") { prioBg = "#ffedd5"; prioText = "#c2410c"; prioBorder = "#fdba74"; prioDot = "#ea580c"; }
    else if (Model.PriorityName == "Medium") { prioBg = "#fef9c3"; prioText = "#a16207"; prioBorder = "#fde047"; prioDot = "#ca8a04"; }
    else if (Model.PriorityName == "Low") { prioBg = "#dcfce7"; prioText = "#15803d"; prioBorder = "#86efac"; prioDot = "#16a34a"; }
}

@section Styles {
    <style>
        /* Horizontal Menu / Tabs styling */
        .nav-tabs-horizontal {
            border: none !important;
            border-bottom: none !important;
            background: transparent !important;
            padding: 8px 16px 4px 16px !important;
            gap: 6px !important;
            overflow: visible !important;
            scrollbar-width: none !important;
            -ms-overflow-style: none !important;
        }

        .nav-tabs-horizontal::-webkit-scrollbar {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
        }

        .nav-tabs-horizontal .nav-link {
            border: none !important;
            color: #64748b;
            font-weight: 600;
            font-size: 0.92rem;
            padding: 8px 16px;
            border-radius: 8px;
            transition: all 0.2s ease-in-out;
            background: transparent;
            display: inline-flex;
            align-items: center;
        }

        .nav-tabs-horizontal .nav-link:hover {
            color: #0084ff;
            background-color: #f1f5f9;
        }

        .nav-tabs-horizontal .nav-link.active {
            color: #0084ff !important;
            background-color: #e0f2fe !important;
            border: none !important;
            font-weight: 700;
        }

        /* Nút Sửa chuyển xuống thanh menu: không viền, cách icon và chữ, hover đẹp */
        .edit-ticket-btn {
            border: none !important;
            color: #64748b !important;
            font-size: 0.9rem;
            font-weight: 600;
            padding: 8px 14px;
            border-radius: 8px;
            transition: all 0.2s ease;
            background: transparent;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px !important;
        }

        .edit-ticket-btn:hover {
            color: #0084ff !important;
            background-color: #f1f5f9 !important;
        }

        /* Unified Refined Badges */
        .badge-ticket-code {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            font-size: 0.82rem;
            font-weight: 700;
            border-radius: 6px;
            background-color: #eff6ff;
            color: #2563eb;
            border: 1px solid #bfdbfe;
        }

        .badge-ticket-item {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            font-size: 0.8rem;
            font-weight: 600;
            border-radius: 6px;
            border: 1px solid transparent;
            line-height: 1.3;
        }

        .badge-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 6px;
            flex-shrink: 0;
        }

        .badge-sla-danger {
            background-color: #fef2f2 !important;
            color: #dc2626 !important;
            border: 1px solid #fecaca !important;
            font-weight: 700;
        }

        /* Nút quay lại không viền */
        .btn-back-header {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: none !important;
            background: transparent;
            color: #64748b;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            transition: all 0.2s ease;
            text-decoration: none;
        }

        .btn-back-header:hover {
            background-color: #f1f5f9;
            color: #0084ff;
            transform: translateX(-2px);
        }

        /* Audit Table Styling */
        #auditTable thead th {
            text-align: center !important;
            white-space: nowrap !important;
            font-size: 0.82rem !important;
            font-weight: 700 !important;
            color: #475569 !important;
            background-color: #f8fafc !important;
            border-bottom: 2px solid #e2e8f0 !important;
            padding: 12px 16px !important;
        }

        #auditTable tbody td {
            white-space: normal !important;
            word-break: break-word !important;
            vertical-align: middle !important;
            padding: 12px 16px !important;
        }

        #auditTable tbody tr:hover {
            background-color: #f8faff !important;
        }

        /* Main Layout & Symmetrical Vertical Spacing */
        .content {
            padding-top: 18px !important;
            padding-bottom: 18px !important;
        }

        .main-panel > .px-4.pt-3:empty,
        .main-panel > .px-4.pt-3:not(:has(.alert)) {
            display: none !important;
            padding: 0 !important;
        }

        .ticket-main-row {
            height: calc(100vh - 150px);
            min-height: 540px;
            margin-bottom: 0 !important;
        }

        .ticket-left-col {
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .ticket-header-card {
            border-radius: 12px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            padding: 8px 16px;
            margin-bottom: 10px;
            flex-shrink: 0;
        }

        .ticket-left-card {
            flex: 1;
            display: flex;
            flex-direction: column;
            border-radius: 12px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            overflow: hidden;
            min-height: 0;
        }

        .ticket-tab-content-wrapper {
            flex: 1;
            overflow-y: auto;
            min-height: 0;
            scroll-behavior: smooth;
        }

        .ticket-right-col {
            display: flex;
            flex-direction: column;
            height: 100%;
            min-width: 250px;
        }

        /* Messenger Sidebar Chat Box (Image 3 Style) */
        .chat-sidebar-card {
            border-radius: 12px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            flex: 1;
            height: 100%;
            min-height: 0;
            background: #ffffff;
            border: 1px solid #e2e8f0;
        }

        @@media (max-width: 991.98px) {
            .ticket-main-row {
                height: auto !important;
                min-height: auto !important;
            }
            .ticket-left-col {
                height: auto !important;
            }
            .ticket-left-card {
                min-height: 500px;
            }
            .ticket-right-col {
                height: 600px !important;
                margin-top: 14px;
            }
        }

        .chat-sidebar-header {
            background: #ffffff;
            border-bottom: 1px solid #e4e6eb;
            padding: 12px 16px;
        }

        .chat-sidebar-body {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
            scroll-behavior: smooth;
            background-color: #f0f2f5;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        /* Outgoing Message (Me - RIGHT) */
        .msg-row-me {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            margin-bottom: 2px;
        }

        .msg-bubble-me {
            background: #0084ff;
            color: #ffffff;
            border-radius: 18px 18px 4px 18px;
            padding: 9px 14px;
            max-width: 82%;
            box-shadow: 0 1px 2px rgba(0, 132, 255, 0.25);
            word-break: break-word;
            font-size: 0.91rem;
            line-height: 1.45;
        }

        .msg-bubble-me.msg-internal {
            background: #d97706 !important;
            box-shadow: 0 1px 3px rgba(217, 119, 6, 0.25);
        }

        .msg-time-me {
            font-size: 0.7rem;
            color: #8a8d91;
            margin-top: 3px;
            padding-right: 4px;
        }

        /* Incoming Message (Other - LEFT) */
        .msg-row-other {
            display: flex;
            align-items: flex-end;
            gap: 8px;
            margin-bottom: 2px;
        }

        .msg-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background-color: #e4e6eb;
            color: #1e293b;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.8rem;
            flex-shrink: 0;
            border: 1px solid #d8dadf;
        }

        .msg-col-other {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            max-width: 82%;
        }

        .msg-header-other {
            font-size: 0.74rem;
            font-weight: 600;
            color: #65676b;
            margin-bottom: 3px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .msg-bubble-other {
            background: #ffffff;
            color: #050505;
            border-radius: 18px 18px 18px 4px;
            padding: 9px 14px;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
            border: 1px solid #e4e6eb;
            word-break: break-word;
            font-size: 0.91rem;
            line-height: 1.45;
        }

        .msg-bubble-other.msg-internal {
            background: #fffbeb !important;
            border: 1px dashed #f59e0b !important;
            color: #78350f !important;
        }

        .msg-time-other {
            font-size: 0.7rem;
            color: #8a8d91;
            margin-top: 3px;
            padding-left: 4px;
        }

        /* Attachment chips */
        .chat-attach-pill-me {
            background: rgba(255, 255, 255, 0.22);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.35);
            border-radius: 6px;
            padding: 3px 8px;
            font-size: 0.78rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: background 0.2s;
        }
        .chat-attach-pill-me:hover {
            background: rgba(255, 255, 255, 0.35);
            color: #ffffff;
        }

        .chat-attach-pill-other {
            background: #f0f2f5;
            color: #0084ff;
            border: 1px solid #e4e6eb;
            border-radius: 6px;
            padding: 3px 8px;
            font-size: 0.78rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: background 0.2s;
        }
        .chat-attach-pill-other:hover {
            background: #e4e6eb;
            color: #0066cc;
        }

        /* Messenger Style Input Footer */
        .chat-sidebar-footer {
            background: #ffffff;
            border-top: 1px solid #e4e6eb;
            padding: 10px 14px;
        }

        .messenger-input-pill {
            background: #f0f2f5;
            border-radius: 20px;
            border: 1px solid transparent;
            padding: 8px 14px;
            font-size: 0.9rem;
            color: #050505;
            outline: none;
            transition: all 0.2s ease;
            resize: none;
        }
        .messenger-input-pill:focus {
            background: #ffffff;
            border-color: #0084ff;
            box-shadow: 0 0 0 2px rgba(0, 132, 255, 0.15);
        }

        .btn-messenger-attach {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f0f2f5;
            color: #0084ff;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
            flex-shrink: 0;
        }
        .btn-messenger-attach:hover {
            background: #e4e6eb;
            color: #0073e6;
        }

        .btn-messenger-send {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #0084ff;
            color: #ffffff;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
            flex-shrink: 0;
            box-shadow: 0 2px 6px rgba(0, 132, 255, 0.25);
        }
        .btn-messenger-send:hover {
            background: #0073e6;
            transform: scale(1.05);
        }
        .btn-messenger-send:active {
            transform: scale(0.96);
        }

        /* Property meta grid */
        .prop-item {
            padding: 9px 12px;
            border-radius: 8px;
            background: #f8fafc;
            border: 1px solid #f1f5f9;
        }
        .prop-label {
            font-size: 0.74rem;
            color: #64748b;
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 0.03em;
            margin-bottom: 2px;
        }
        .prop-value {
            font-size: 0.88rem;
            font-weight: 600;
            color: #1e293b;
        }
    </style>
}

<!-- Main Row: Left (Header Bar + Tabs & Content) + Right (Messenger Chat Box) -->
<div class="row g-3 ticket-main-row">
    <!-- CỘT TRÁI: Được mở rộng thêm 20% diện tích từ hộp chat -->
    <div class="col-lg-8 col-xl-9 ticket-left-col">
        <!-- 1. Thanh tiêu đề & tác vụ (được thu nhỏ bằng chiều rộng menu) -->
        <div class="ticket-header-card shadow-sm d-flex align-items-center justify-content-between">
            <!-- Cụm bên trái: Mã phiếu + Badges ở trên, Tiêu đề ở dưới -->
            <div class="d-flex flex-column gap-1.5 overflow-hidden me-3">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <!-- Mã phiếu -->
                    <span class="badge-ticket-code font-monospace">
                        <i class="fas fa-ticket me-1.5 text-primary"></i>@Model.TicketCode
                    </span>

                    <!-- Mức độ ưu tiên -->
                    <span class="badge-ticket-item" style="background-color: @prioBg; color: @prioText; border-color: @prioBorder;">
                        <span class="badge-dot" style="background-color: @prioDot;"></span>
                        @Model.PriorityName
                    </span>

                    <!-- Trạng thái chuẩn xác, rõ ràng -->
                    <span class="badge-ticket-item" style="background-color: @statusBg; color: @statusText; border-color: @statusBorder;">
                        <i class="fas fa-circle-dot me-1" style="font-size: 0.65rem;"></i>
                        @Model.StatusDisplay
                    </span>

                    <!-- Quá hạn SLA (nếu có) -->
                    @if (Model.IsSLAViolated)
                    {
                        <span class="badge-ticket-item badge-sla-danger">
                            <i class="fas fa-triangle-exclamation me-1"></i>Quá hạn SLA
                        </span>
                    }
                </div>

                <div class="text-start mt-0.5" style="padding-left: 30px;">
                    <h5 class="fw-bold text-dark m-0 text-truncate" title="@Model.Title" style="font-size: 1.05rem; letter-spacing: -0.01em; line-height: 1.35;">
                        @Model.Title
                    </h5>
                </div>
            </div>

            <!-- Cụm bên phải: Nút Quay lại căn giữa theo chiều dọc, BỎ VIỀN, chỉ để mỗi icon mũi tên -->
            <div class="flex-shrink-0">
                <a href="@Url.Action("Index", "Ticket")" 
                   class="btn-back-header" 
                   title="Quay lại danh sách phiếu">
                    <i class="fas fa-arrow-left"></i>
                </a>
            </div>
        </div>

        <!-- 2. Thẻ Tabs & Nội dung chi tiết/tiến độ/nhật ký -->
        <div class="ticket-left-card shadow-sm">
            <!-- Thanh menu ngang 3 tab + Nút Sửa căn phải -->
            <ul class="nav nav-tabs-horizontal" id="ticketDetailTabs" role="tablist">
                <!-- Mục 1: Chi tiết sự cố -->
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="tab-info-btn" data-bs-toggle="tab" data-bs-target="#tab-info-pane" type="button" role="tab" aria-controls="tab-info-pane" aria-selected="true">
                        <i class="fas fa-file-lines me-2 text-primary"></i>
                        <span>Chi tiết sự cố</span>
                    </button>
                </li>

                <!-- Mục 2: Tiến độ & Xử lý -->
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-workflow-btn" data-bs-toggle="tab" data-bs-target="#tab-workflow-pane" type="button" role="tab" aria-controls="tab-workflow-pane" aria-selected="false">
                        <i class="fas fa-tasks me-2 text-info"></i>
                        <span>Tiến độ &amp; Xử lý</span>
                    </button>
                </li>

                <!-- Mục 3: Nhật ký kiểm toán -->
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-audit-btn" data-bs-toggle="tab" data-bs-target="#tab-audit-pane" type="button" role="tab" aria-controls="tab-audit-pane" aria-selected="false">
                        <i class="fas fa-clock-rotate-left me-2 text-secondary"></i>
                        <span>Nhật ký thay đổi</span>
                    </button>
                </li>

                <!-- Nút Sửa: Chuyển xuống thanh menu, căn phải, bỏ khung viền, cách chữ rõ ràng -->
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item ms-auto" role="presentation">
                        <a href="@Url.Action("Edit", "Ticket", new { id = Model.TicketId })" 
                           class="edit-ticket-btn" 
                           title="Chỉnh sửa thông tin phiếu">
                            <i class="fas fa-pen small"></i>
                            <span>Sửa</span>
                        </a>
                    </li>
                }
            </ul>

            <!-- Tab Content Panes với vùng cuộn nội dung độc lập -->
            <div class="tab-content bg-white ticket-tab-content-wrapper" id="ticketDetailTabsContent">
                
                <!-- PANE 1: CHI TIẾT SỰ CỐ -->
                <div class="tab-pane fade show active p-3 px-3.5" id="tab-info-pane" role="tabpanel" aria-labelledby="tab-info-btn">
                    <!-- 1. Nội dung mô tả sự cố -->
                    <div class="mb-3">
                        <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                            <i class="fas fa-align-left text-primary"></i>
                            <span>Nội dung mô tả sự cố</span>
                        </h6>
                        <div class="p-3 bg-light bg-opacity-75 rounded-3 text-dark border-start border-primary border-4" 
                             style="white-space: pre-wrap; line-height: 1.7; font-size: 0.93rem; min-height: 70px; max-height: 140px; overflow-y: auto; background-color: #f8fafc;">
                            @Model.Description
                        </div>
                    </div>

                    <!-- 2. Tệp đính kèm lúc tạo phiếu (nếu có) -->
                    @if (Model.Attachments != null && Model.Attachments.Any())
                    {
                        <div class="mb-4 pt-2 border-top">
                            <h6 class="fw-bold text-dark mb-2.5 d-flex align-items-center gap-2">
                                <i class="fas fa-paperclip text-primary"></i>
                                <span>Tệp đính kèm ban đầu (@Model.Attachments.Count)</span>
                            </h6>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var att in Model.Attachments)
                                {
                                    <a href="@Url.Action("Download", "Comment", new { id = att.AttachmentId })" 
                                       class="btn btn-outline-primary d-inline-flex align-items-center gap-2 px-3 py-1.5 bg-light bg-opacity-50 rounded-2 shadow-none small"
                                       title="Tải về tệp đính kèm">
                                        <i class="fas fa-file-download text-primary"></i>
                                        <span class="fw-semibold text-dark">@att.FileName</span>
                                        <span class="badge bg-secondary ms-1">@att.FileSize</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    <!-- 3. Thông tin tổng quát thuộc tính -->
                    <div class="pt-2 border-top">
                        <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                            <i class="fas fa-circle-info text-primary"></i>
                            <span>Thông tin tổng quát sự cố</span>
                        </h6>
                        <div class="row g-2">
                            <div class="col-md-6 col-lg-4">
                                <div class="prop-item">
                                    <div class="prop-label">Mã phiếu</div>
                                    <div class="prop-value font-monospace text-primary">@Model.TicketCode</div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <div class="prop-item">
                                    <div class="prop-label">Danh mục sự cố</div>
                                    <div class="prop-value">@Model.CategoryName</div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <div class="prop-item">
                                    <div class="prop-label">Mức độ ưu tiên</div>
                                    <div class="prop-value">
                                        <span class="badge" style="background-color: @Model.PriorityColor; color: white;">
                                            @Model.PriorityName
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <div class="prop-item">
                                    <div class="prop-label">Trạng thái</div>
                                    <div class="prop-value">
                                        <span class="badge" style="background-color: @Model.StatusColor; color: white;">
                                            @Model.StatusDisplay
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <div class="prop-item">
                                    <div class="prop-label">Người gửi yêu cầu</div>
                                    <div class="prop-value text-truncate" title="@Model.CreatedByName">@Model.CreatedByName</div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <div class="prop-item">
                                    <div class="prop-label">Kỹ thuật viên</div>
                                    <div class="prop-value text-truncate" title="@(string.IsNullOrEmpty(Model.AssignedToName) ? "Chưa phân công" : Model.AssignedToName)">
                                        @(string.IsNullOrEmpty(Model.AssignedToName) ? "Chưa phân công" : Model.AssignedToName)
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-6">
                                <div class="prop-item">
                                    <div class="prop-label">Thời gian gửi</div>
                                    <div class="prop-value">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-6">
                                <div class="prop-item">
                                    <div class="prop-label">Cam kết SLA</div>
                                    <div class="prop-value">
                                        @if (Model.SLADueDate.HasValue)
                                        {
                                            <span class="@(Model.IsSLAViolated ? "text-danger" : "text-dark")">
                                                @Model.SLADueDate.Value.ToString("dd/MM/yyyy HH:mm")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Không áp dụng</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PANE 2: TIẾN ĐỘ & XỬ LÝ -->
                <div class="tab-pane fade p-4" id="tab-workflow-pane" role="tabpanel" aria-labelledby="tab-workflow-btn">
                    <div class="row g-4">
                        <!-- Mốc thời gian xử lý -->
                        <div class="col-12 col-xl-6">
                            <div class="card border border-light-subtle shadow-none h-100 bg-light bg-opacity-25">
                                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                                    <span class="badge bg-primary-soft text-primary p-2 rounded-circle"><i class="fas fa-timeline"></i></span>
                                    <h6 class="m-0 fw-bold text-dark">Tiến độ &amp; Mốc thời gian</h6>
                                </div>
                                <div class="card-body p-3">
                                    <div class="list-group list-group-flush">
                                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2.5 bg-transparent">
                                            <div>
                                                <i class="fas fa-check-circle text-success me-2"></i>
                                                <strong class="text-dark small">1. Tiếp nhận sự cố</strong>
                                                <div class="text-muted" style="font-size: 0.76rem; padding-left: 22px;">Người dùng tạo phiếu</div>
                                            </div>
                                            <span class="badge bg-light text-dark border">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                                        </div>

                                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2.5 border-top bg-transparent">
                                            <div>
                                                @if (Model.AssignedDate.HasValue)
                                                {
                                                    <i class="fas fa-check-circle text-success me-2"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-circle text-muted me-2"></i>
                                                }
                                                <strong class="text-dark small">2. Phân công xử lý</strong>
                                                <div class="text-muted" style="font-size: 0.76rem; padding-left: 22px;">Chỉ định KTV phụ trách</div>
                                            </div>
                                            <span class="small">
                                                @(Model.AssignedDate.HasValue ? Model.AssignedDate.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa thực hiện")
                                            </span>
                                        </div>

                                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2.5 border-top bg-transparent">
                                            <div>
                                                @if (Model.ResolvedDate.HasValue)
                                                {
                                                    <i class="fas fa-check-circle text-success me-2"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-circle text-muted me-2"></i>
                                                }
                                                <strong class="text-dark small">3. Giải quyết sự cố</strong>
                                                <div class="text-muted" style="font-size: 0.76rem; padding-left: 22px;">Hoàn tất khắc phục</div>
                                            </div>
                                            <span class="small">
                                                @(Model.ResolvedDate.HasValue ? Model.ResolvedDate.Value.ToString("dd/MM/yyyy HH:mm") : "Đang xử lý")
                                            </span>
                                        </div>

                                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2.5 border-top bg-transparent">
                                            <div>
                                                @if (Model.ClosedDate.HasValue)
                                                {
                                                    <i class="fas fa-check-circle text-success me-2"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-circle text-muted me-2"></i>
                                                }
                                                <strong class="text-dark small">4. Đóng phiếu nghiệm thu</strong>
                                                <div class="text-muted" style="font-size: 0.76rem; padding-left: 22px;">Khách hàng xác nhận</div>
                                            </div>
                                            <span class="small">
                                                @(Model.ClosedDate.HasValue ? Model.ClosedDate.Value.ToString("dd/MM/yyyy HH:mm") : "Chờ nghiệm thu")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Điều phối trạng thái, Phân công KTV & Đánh giá -->
                        <div class="col-12 col-xl-6">
                            <!-- Chuyển đổi trạng thái -->
                            @if (Model.CanChangeStatus && Model.AllowedTransitions != null && Model.AllowedTransitions.Any())
                            {
                                <div class="card border border-light-subtle shadow-none mb-3">
                                    <div class="card-header bg-white py-2.5 border-bottom d-flex align-items-center gap-2">
                                        <span class="badge bg-primary-soft text-primary p-2 rounded-circle"><i class="fas fa-exchange-alt"></i></span>
                                        <h6 class="m-0 fw-bold text-dark small">Chuyển đổi trạng thái</h6>
                                    </div>
                                    <div class="card-body p-3">
                                        <div class="d-grid gap-2">
                                            @foreach (var nextStatus in Model.AllowedTransitions)
                                            {
                                                <form action="@Url.Action("ChangeStatus", "Ticket")" method="post" class="m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="ticketId" value="@Model.TicketId" />
                                                    <input type="hidden" name="newStatus" value="@nextStatus" />
                                                    
                                                    @{
                                                        string btnClass = "btn-outline-primary";
                                                        string iconClass = "fa-arrow-right";
                                                        
                                                        if (nextStatus == TicketStatus.InProgress) { btnClass = "btn-outline-warning text-dark"; iconClass = "fa-play"; }
                                                        else if (nextStatus == TicketStatus.Resolved) { btnClass = "btn-outline-success"; iconClass = "fa-check-double"; }
                                                        else if (nextStatus == TicketStatus.Closed) { btnClass = "btn-outline-secondary"; iconClass = "fa-lock"; }
                                                        else if (nextStatus == TicketStatus.Reopened) { btnClass = "btn-outline-danger"; iconClass = "fa-redo"; }
                                                    }

                                                    <button type="submit" class="btn @btnClass w-100 text-start d-flex align-items-center justify-content-between py-2 px-3 fw-semibold rounded-2 shadow-none mb-1 small">
                                                        <span><i class="fas @iconClass me-2"></i>Chuyển sang: <strong>@nextStatus</strong></span>
                                                        <i class="fas fa-chevron-right small opacity-50"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Phân công KTV (Admin) -->
                            @if (Model.CanAssign)
                            {
                                <div class="card border border-light-subtle shadow-none mb-3">
                                    <div class="card-header bg-white py-2.5 border-bottom d-flex align-items-center gap-2">
                                        <span class="badge bg-primary-soft text-primary p-2 rounded-circle"><i class="fas fa-user-gear"></i></span>
                                        <h6 class="m-0 fw-bold text-dark small">Phân công Kỹ thuật viên</h6>
                                    </div>
                                    <div class="card-body p-3">
                                        <form action="@Url.Action("Assign", "Ticket")" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ticketId" value="@Model.TicketId" />
                                            <div class="mb-2">
                                                <label class="form-label small fw-bold text-dark">Chọn nhân sự phụ trách:</label>
                                                @Html.DropDownList("technicianId", Model.Technicians ?? new List<SelectListItem>(), "-- Chọn nhân sự kỹ thuật --", new { @class = "form-select form-select-sm", required = "required" })
                                            </div>
                                            <button type="submit" class="btn btn-sm btn-primary w-100 fw-bold shadow-sm py-2 rounded-2">
                                                <i class="fas fa-check me-1"></i> Xác nhận phân công
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }

                            <!-- Đánh giá chất lượng dịch vụ -->
                            @if (Model.HasRated)
                            {
                                <div class="card border border-warning-subtle shadow-none mb-3 bg-light">
                                    <div class="card-header bg-white py-2.5 border-bottom d-flex align-items-center gap-2">
                                        <span class="badge bg-warning-soft text-warning p-2 rounded-circle"><i class="fas fa-star"></i></span>
                                        <h6 class="m-0 fw-bold text-dark small">Đánh giá từ khách hàng</h6>
                                    </div>
                                    <div class="card-body text-center p-3">
                                        <div class="mb-1">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= (Model.RatingStars ?? 0))
                                                {
                                                    <i class="fas fa-star text-warning"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star text-muted opacity-25"></i>
                                                }
                                            }
                                        </div>
                                        <span class="badge bg-success px-3 py-1 small">@Model.RatingStars / 5 sao</span>
                                        @if (!string.IsNullOrEmpty(Model.RatingComment))
                                        {
                                            <p class="fst-italic text-muted mt-2 mb-0 small">"@Model.RatingComment"</p>
                                        }
                                    </div>
                                </div>
                            }
                            else if (Model.CanRate)
                            {
                                <div class="card border border-success-subtle shadow-none mb-3">
                                    <div class="card-header bg-white py-2.5 border-bottom d-flex align-items-center gap-2">
                                        <span class="badge bg-success-soft text-success p-2 rounded-circle"><i class="fas fa-star text-warning"></i></span>
                                        <h6 class="m-0 fw-bold text-success small">Đánh giá độ hài lòng</h6>
                                    </div>
                                    <div class="card-body p-3">
                                        <p class="text-muted small mb-2">Đánh giá chất lượng hỗ trợ sự cố:</p>
                                        <form action="@Url.Action("Rate", "Ticket")" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ticketId" value="@Model.TicketId" />
                                            <div class="mb-2 text-center">
                                                <select name="stars" class="form-select form-select-sm d-inline-block w-auto fw-bold text-warning border-warning">
                                                    <option value="5" selected>⭐⭐⭐⭐⭐ (5 sao - Rất tốt)</option>
                                                    <option value="4">⭐⭐⭐⭐ (4 sao - Tốt)</option>
                                                    <option value="3">⭐⭐⭐ (3 sao - Bình thường)</option>
                                                    <option value="2">⭐⭐ (2 sao - Chưa tốt)</option>
                                                    <option value="1">⭐ (1 sao - Kém)</option>
                                                </select>
                                            </div>
                                            <div class="mb-2">
                                                <textarea name="comment" class="form-control form-control-sm" rows="2" placeholder="Góp ý thêm (nếu có)..."></textarea>
                                            </div>
                                            <button type="submit" class="btn btn-sm btn-success w-100 fw-bold shadow-sm py-1.5 rounded-2">
                                                <i class="fas fa-paper-plane me-1"></i> Gửi đánh giá
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- PANE 3: NHẬT KÝ KIỂM TOÁN -->
                <div class="tab-pane fade p-0" id="tab-audit-pane" role="tabpanel" aria-labelledby="tab-audit-btn">
                    <div class="p-3 border-bottom bg-light bg-opacity-50 d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="fw-bold text-dark m-0 small d-flex align-items-center gap-2">
                                <i class="fas fa-history text-primary"></i>
                                <span>Nhật ký kiểm toán &amp; Lịch sử thay đổi</span>
                            </h6>
                        </div>
                        <span class="badge bg-white text-secondary border px-2 py-1 small">
                            @(Model.History != null ? Model.History.Count : 0) bản ghi
                        </span>
                    </div>

                    @if (Model.History != null && Model.History.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" id="auditTable">
                                <thead>
                                    <tr>
                                        <th class="text-center text-nowrap" style="width: 25%;">THỜI GIAN</th>
                                        <th class="text-center text-nowrap" style="width: 28%;">NGƯỜI THỰC HIỆN</th>
                                        <th class="text-center text-nowrap" style="width: 47%;">NỘI DUNG THAY ĐỔI</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var h in Model.History)
                                    {
                                        <tr>
                                            <td class="text-center text-muted small">
                                                <i class="far fa-clock me-1 text-secondary"></i>@h.ChangedDate.ToString("dd/MM/yyyy HH:mm")
                                            </td>
                                            <td class="text-center">
                                                <span class="fw-semibold text-dark"><i class="fas fa-user-edit text-primary me-1 small"></i>@h.ChangedByName</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border me-1">@h.FieldChanged</span>
                                                @if (!string.IsNullOrEmpty(h.OldValue))
                                                {
                                                    <span class="text-muted text-decoration-line-through small">@h.OldValue</span>
                                                    <i class="fas fa-arrow-right mx-1 text-muted small"></i>
                                                }
                                                <strong class="text-primary">@h.NewValue</strong>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-5 text-muted text-center">
                            <i class="fas fa-folder-open fa-2x mb-2 text-secondary opacity-50"></i>
                            <p class="m-0 small">Chưa có bản ghi lịch sử thay đổi nào.</p>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>

    <!-- CỘT PHẢI: HỘP CHAT PHONG CÁCH MESSENGER (THU HẸP 20% CHIỀU NGANG) -->
    <div class="col-lg-4 col-xl-3 ticket-right-col">
        <div class="chat-sidebar-card shadow-sm">
            <!-- Messenger Header -->
            <div class="chat-sidebar-header d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2 overflow-hidden">
                    <div class="msg-avatar text-white flex-shrink-0" style="background-color: #0084ff; border: none; width: 34px; height: 34px;">
                        <i class="fas fa-comments fs-6"></i>
                    </div>
                    <div class="overflow-hidden">
                        <div class="fw-bold text-dark text-truncate" style="font-size: 0.92rem; line-height: 1.2;">
                            Trao đổi sự cố
                        </div>
                        <div class="text-muted text-truncate" style="font-size: 0.72rem;">
                            <i class="fas fa-circle text-success me-1" style="font-size: 0.55rem;"></i>@commentCount tin nhắn
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-1">
                    <a href="@Url.Action("Chat", "Ticket", new { id = Model.TicketId })" 
                       class="btn btn-sm btn-light text-muted rounded-circle p-1" 
                       style="width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center;"
                       title="Mở toàn màn hình phòng chat">
                        <i class="fas fa-up-right-from-square small"></i>
                    </a>
                </div>
            </div>

            <!-- Messenger Messages Body -->
            <div class="chat-sidebar-body" id="chatMessagesContainer">
                @if (Model.Comments != null && Model.Comments.Any())
                {
                    foreach (var c in Model.Comments)
                    {
                        bool isMe = (!string.IsNullOrEmpty(c.UserId) && c.UserId == currentUserId) || 
                                    (!string.IsNullOrEmpty(c.UserName) && (c.UserName == currentUserName || c.UserName == User.Identity.Name));

                        string initial = !string.IsNullOrEmpty(c.UserName) ? c.UserName.Substring(0, 1).ToUpper() : "U";

                        if (isMe)
                        {
                            <!-- MY MESSAGE (BÊN PHẢI) -->
                            <div class="msg-row-me">
                                <div class="msg-bubble-me @(c.IsInternalNote ? "msg-internal" : "")">
                                    @if (c.IsInternalNote)
                                    {
                                        <div class="d-flex align-items-center gap-1 small fw-bold text-warning mb-1" style="font-size: 0.72rem;">
                                            <i class="fas fa-lock"></i> Ghi chú nội bộ
                                        </div>
                                    }
                                    <div style="white-space: pre-wrap;">@c.Content</div>

                                    <!-- Attachments in my comment -->
                                    @if (c.Attachments != null && c.Attachments.Any())
                                    {
                                        <div class="mt-1.5 pt-1.5 border-top border-white border-opacity-25 d-flex flex-wrap gap-1">
                                            @foreach (var att in c.Attachments)
                                            {
                                                <a href="@Url.Action("Download", "Comment", new { id = att.AttachmentId })" 
                                                   class="chat-attach-pill-me"
                                                   target="_blank" title="@att.FileName (@att.FileSize)">
                                                    <i class="fas fa-paperclip"></i>
                                                    <span class="text-truncate" style="max-width: 120px;">@att.FileName</span>
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                                <span class="msg-time-me">
                                    @c.CreatedDate.ToString("HH:mm")
                                </span>
                            </div>
                        }
                        else
                        {
                            <!-- OTHER PERSON'S MESSAGE (BÊN TRÁI) -->
                            <div class="msg-row-other">
                                <div class="msg-avatar" title="@c.UserName">
                                    @initial
                                </div>
                                <div class="msg-col-other">
                                    <div class="msg-header-other">
                                        <span class="text-truncate" style="max-width: 130px;">@c.UserName</span>
                                        @if (!string.IsNullOrEmpty(c.UserRole))
                                        {
                                            string roleBadge = "bg-secondary";
                                            if (c.UserRole == "Admin") { roleBadge = "bg-danger"; }
                                            else if (c.UserRole == "Technician" || c.UserRole == "Nhân viên") { roleBadge = "bg-primary"; }
                                            else { roleBadge = "bg-info text-dark"; }
                                            <span class="badge @roleBadge" style="font-size: 0.6rem; padding: 1px 4px;">@c.UserRole</span>
                                        }
                                    </div>
                                    <div class="msg-bubble-other @(c.IsInternalNote ? "msg-internal" : "")">
                                        @if (c.IsInternalNote)
                                        {
                                            <div class="d-flex align-items-center gap-1 small fw-bold text-warning mb-1" style="font-size: 0.72rem;">
                                                <i class="fas fa-lock"></i> Ghi chú nội bộ
                                            </div>
                                        }
                                        <div style="white-space: pre-wrap;">@c.Content</div>

                                        <!-- Attachments in other's comment -->
                                        @if (c.Attachments != null && c.Attachments.Any())
                                        {
                                            <div class="mt-1.5 pt-1.5 border-top d-flex flex-wrap gap-1">
                                                @foreach (var att in c.Attachments)
                                                {
                                                    <a href="@Url.Action("Download", "Comment", new { id = att.AttachmentId })" 
                                                       class="chat-attach-pill-other"
                                                       target="_blank" title="@att.FileName (@att.FileSize)">
                                                    <i class="fas fa-paperclip"></i>
                                                    <span class="text-truncate" style="max-width: 120px;">@att.FileName</span>
                                                    </a>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <span class="msg-time-other">
                                        @c.CreatedDate.ToString("HH:mm")
                                    </span>
                                </div>
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="h-100 d-flex flex-column align-items-center justify-content-center text-center p-3 text-muted">
                        <div class="rounded-circle bg-white p-3 shadow-xs mb-2 text-primary opacity-75">
                            <i class="fas fa-comments fa-2x"></i>
                        </div>
                        <h6 class="fw-bold text-dark small mb-1">Chưa có tin nhắn</h6>
                        <p class="text-muted" style="font-size: 0.76rem;">Gửi tin nhắn đầu tiên để bắt đầu trao đổi với kỹ thuật viên.</p>
                    </div>
                }
            </div>

            <!-- Messenger Style Input Footer -->
            <div class="chat-sidebar-footer">
                <form action="@Url.Action("Add", "Comment")" method="post" enctype="multipart/form-data" id="chatCommentForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ticketId" value="@Model.TicketId" />
                    <input type="hidden" name="returnUrl" value="@Url.Action("Details", "Ticket", new { id = Model.TicketId })" />

                    <!-- Staff Internal note toggle & Selected Files pill -->
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-1 mb-1.5">
                        <div>
                            @if (isStaff)
                            {
                                <div class="form-check form-switch m-0" style="min-height: auto;">
                                    <input class="form-check-input" type="checkbox" id="isInternalNoteTab" name="isInternalNote" value="true" style="width: 28px; height: 16px;">
                                    <label class="form-check-label text-warning" for="isInternalNoteTab" style="font-size: 0.72rem; font-weight: 600;">
                                        <i class="fas fa-lock me-1"></i>Ghi chú nội bộ
                                    </label>
                                </div>
                            }
                        </div>
                        <div id="fileSelectedBadge" class="small text-primary d-none align-items-center gap-1 bg-light px-2 py-0.5 rounded-pill border" style="font-size: 0.7rem;">
                            <i class="fas fa-paperclip"></i>
                            <span id="fileCountText">0 tệp</span>
                            <button type="button" class="btn btn-link btn-sm text-danger p-0 ms-1 text-decoration-none" onclick="clearAttachments()">
                                &times;
                            </button>
                        </div>
                    </div>

                    <!-- Input row: Attachment button + Pill Input + Send button -->
                    <div class="d-flex align-items-center gap-1.5">
                        <!-- Nút đính kèm tệp tin -->
                        <label class="btn-messenger-attach" for="chatFileInput" title="Đính kèm tệp tin">
                            <i class="fas fa-paperclip small"></i>
                        </label>
                        <input type="file" id="chatFileInput" name="attachments" multiple class="d-none" onchange="onFilesSelected(this)" />

                        <!-- Ô nhập tin nhắn phong cách Messenger / Zalo -->
                        <textarea name="content" id="chatInputContent" class="form-control messenger-input-pill flex-grow-1" rows="1" 
                                  placeholder="Nhập tin nhắn..." required></textarea>

                        <!-- Nút gửi tin nhắn hình tròn -->
                        <button type="submit" class="btn-messenger-send" title="Gửi tin nhắn">
                            <i class="fas fa-paper-plane small"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function activateTab(tabBtnId) {
            var triggerEl = document.getElementById(tabBtnId);
            if (triggerEl) {
                var tab = new bootstrap.Tab(triggerEl);
                tab.show();
            }
        }

        function scrollToBottom() {
            var chatBox = document.getElementById('chatMessagesContainer');
            if (chatBox) {
                chatBox.scrollTop = chatBox.scrollHeight;
            }
        }

        function onFilesSelected(input) {
            var badge = document.getElementById('fileSelectedBadge');
            var text = document.getElementById('fileCountText');
            if (input.files && input.files.length > 0) {
                badge.classList.remove('d-none');
                badge.classList.add('d-inline-flex');
                text.textContent = input.files.length + ' tệp (' + input.files[0].name + (input.files.length > 1 ? ',...' : '') + ')';
            } else {
                badge.classList.remove('d-inline-flex');
                badge.classList.add('d-none');
            }
        }

        function clearAttachments() {
            var input = document.getElementById('chatFileInput');
            if (input) input.value = '';
            var badge = document.getElementById('fileSelectedBadge');
            if (badge) {
                badge.classList.remove('d-inline-flex');
                badge.classList.add('d-none');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Scroll chat to bottom on load
            setTimeout(scrollToBottom, 150);

            // Check hash in URL to automatically switch tabs (e.g. #tab-workflow or #tab-audit)
            var hash = window.location.hash;
            if (hash === '#tab-workflow' || hash === '#workflow') {
                activateTab('tab-workflow-btn');
            } else if (hash === '#tab-audit' || hash === '#audit') {
                activateTab('tab-audit-btn');
            }

            // Listen to tab switch events to sync URL hash
            var tabLinks = document.querySelectorAll('#ticketDetailTabs button[data-bs-toggle="tab"]');
            tabLinks.forEach(function (btn) {
                btn.addEventListener('shown.bs.tab', function (e) {
                    if (e.target.id === 'tab-workflow-btn') {
                        history.replaceState(null, null, '#tab-workflow');
                    } else if (e.target.id === 'tab-audit-btn') {
                        history.replaceState(null, null, '#tab-audit');
                    } else {
                        history.replaceState(null, null, ' ');
                    }
                });
            });

            // Enter key to send message in chat (Shift+Enter for newline)
            var chatInput = document.getElementById('chatInputContent');
            if (chatInput) {
                chatInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        if (chatInput.value.trim() !== '') {
                            document.getElementById('chatCommentForm').submit();
                        }
                    }
                });
            }
        });
    </script>
}
